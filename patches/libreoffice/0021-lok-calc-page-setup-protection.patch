+/// Applies a kit client's page JSON to the page style.
+bool lcl_KitPage(ScDocShell& rDocSh, SCTAB nTab, const OUString& rJson)
+{
+    constexpr int nMinScale = 10;
+    constexpr int nMaxScale = 400;
+    constexpr int nMaxPages = 1000;
+    boost::property_tree::ptree aTree;
+    std::stringstream aStream{ std::string(rJson.toUtf8()) };
+    bool bLandscape = false;
+    try
+    {
+        boost::property_tree::read_json(aStream, aTree);
+        bLandscape = aTree.get<bool>("landscape");
+    }
+    catch (const boost::property_tree::ptree_error&)
+    {
+        return false;
+    }
+    sal_uInt16 nScale = 0;
+    sal_uInt16 nPages = 0;
+    ScPageScaleToItem aScaleTo;
+    if (const auto oScale = aTree.get_optional<int>("scale"))
+    {
+        if (*oScale < nMinScale || *oScale > nMaxScale)
+            return false;
+        nScale = *oScale;
+    }
+    else if (const auto oFit = aTree.get_child_optional("fit"))
+    {
+        std::vector<int> aFit;
+        for (const auto& rItem : *oFit)
+            aFit.push_back(rItem.second.get_value<int>(-1));
+        if (aFit.size() != 2 || aFit[0] < 0 || aFit[1] < 0 || aFit[0] > nMaxPages
+            || aFit[1] > nMaxPages || (aFit[0] == 0 && aFit[1] == 0))
+            return false;
+        aScaleTo.Set(aFit[0], aFit[1]);
+    }
+    else if (const auto oPages = aTree.get_optional<int>("pages"))
+    {
+        if (*oPages < 1 || *oPages > nMaxPages)
+            return false;
+        nPages = *oPages;
+    }
+    else
+        return false;
+
+    ScDocument& rDoc = rDocSh.GetDocument();
+    const OUString aName = rDoc.GetPageStyle(nTab);
+    SfxStyleSheetBase* pStyle = rDoc.GetStyleSheetPool()->Find(aName, SfxStyleFamily::Page);
+    if (!pStyle)
+        return false;
+    ScStyleSaveData aOld;
+    aOld.InitFromStyle(pStyle);
+    SfxItemSet aSet(pStyle->GetItemSet());
+    SvxPageItem aPage(aSet.Get(ATTR_PAGE));
+    aPage.SetLandscape(bLandscape);
+    aSet.Put(aPage);
+    const Size aSize = aSet.Get(ATTR_PAGE_SIZE).GetSize();
+    if ((aSize.Width() > aSize.Height()) != bLandscape)
+        aSet.Put(SvxSizeItem(ATTR_PAGE_SIZE, Size(aSize.Height(), aSize.Width())));
+    aSet.Put(SfxUInt16Item(ATTR_PAGE_SCALE, nScale));
+    aSet.Put(SfxUInt16Item(ATTR_PAGE_SCALETOPAGES, nPages));
+    aSet.Put(aScaleTo);
+    rDoc.ModifyStyleSheet(*pStyle, aSet);
+    ScStyleSaveData aNew;
+    aNew.InitFromStyle(pStyle);
+    if (rDoc.IsUndoEnabled())
+        rDocSh.GetUndoManager()->AddUndoAction(
+            std::make_unique<ScUndoModifyStyle>(rDocSh, SfxStyleFamily::Page, aOld, aNew));
+    rDocSh.PageStyleModified(aName, true);
+    return true;
+}
+}
