+namespace
+{
+/// Protects or unprotects as a kit client's JSON asks.
+bool lcl_KitProtect(ScTabViewShell& rShell, SCTAB nTab, bool bOld, const OUString& rJson)
+{
+    boost::property_tree::ptree aTree;
+    std::stringstream aStream{ std::string(rJson.toUtf8()) };
+    try
+    {
+        boost::property_tree::read_json(aStream, aTree);
+    }
+    catch (const boost::property_tree::json_parser_error&)
+    {
+        return false;
+    }
+    const bool bProtect = aTree.get<bool>("protect", false);
+    const OUString aPassword = OUString::fromUtf8(aTree.get<std::string>("password", ""));
+    if (bProtect == bOld)
+        return false;
+    if (!bProtect)
+    {
+        // A wrong password changes nothing.
+        if (!rShell.GetViewData().GetDocShell()->GetDocFunc().Unprotect(nTab, aPassword, true))
+            return false;
+        rShell.SetTabProtectionSymbol(nTab, false);
+        return true;
+    }
+    ScTableProtection aNew;
+    aNew.setProtected(true);
+    aNew.setPassword(aPassword);
+    for (const auto& [rName, eOption] : aKitProtectOptions)
+        aNew.setOption(eOption, false);
+    if (const auto oAllow = aTree.get_child_optional("allow"))
+    {
+        for (const auto& rItem : *oAllow)
+        {
+            const std::string aName = rItem.second.get_value<std::string>();
+            const auto pFound = std::find_if(std::begin(aKitProtectOptions), std::end(aKitProtectOptions),
+                                             [&aName](const auto& rOption) { return rOption.first == aName; });
+            if (pFound == std::end(aKitProtectOptions))
+                return false;
+            aNew.setOption(pFound->second, true);
+        }
+    }
+    ScModule::get()->InputEnterHandler();
+    rShell.ProtectSheet(nTab, aNew);
+    return true;
+}
+}
