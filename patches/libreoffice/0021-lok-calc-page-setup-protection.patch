+/// The sheet's protection and its allowed actions.
+void lcl_SheetProtection(tools::JsonWriter& rJson, ScDocument& rDoc, SCTAB nTab)
+{
+    const ScTableProtection aNone;
+    const ScTableProtection* pProtect = rDoc.GetTabProtection(nTab);
+    const ScTableProtection& rProtect = pProtect ? *pProtect : aNone;
+    rJson.put("protected", rProtect.isProtected());
+    rJson.put("password", rProtect.isProtected() && rProtect.isProtectedWithPass());
+    auto aAllow = rJson.startArray("allow");
+    for (const auto& [rName, eOption] : aKitProtectOptions)
+        if (rProtect.isOptionEnabled(eOption))
+            rJson.putSimpleValue(OUString::fromUtf8(rName));
+}
