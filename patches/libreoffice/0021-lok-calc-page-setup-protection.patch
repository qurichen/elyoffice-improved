+/// A repeated row or column span, 1-based.
+void lcl_PutSpan(tools::JsonWriter& rJson, std::string_view rName, const std::optional<ScRange>& oRange,
+                 bool bRows)
+{
+    if (!oRange)
+        return;
+    auto aNode = rJson.startNode(rName);
+    rJson.put("first", (bRows ? oRange->aStart.Row() : oRange->aStart.Col()) + 1);
+    rJson.put("last", (bRows ? oRange->aEnd.Row() : oRange->aEnd.Col()) + 1);
+}
