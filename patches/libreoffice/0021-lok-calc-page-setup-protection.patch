+/// Print ranges, titles, page setup and breaks at the cursor.
+void lcl_PrintLayout(tools::JsonWriter& rJson, ScDocument& rDoc, const ScAddress& rCursor)
+{
+    const SCTAB nTab = rCursor.Tab();
+    const ScAddress::Details aDetails(rDoc.GetAddressConvention(), 0, 0);
+    {
+        auto aAreas = rJson.startArray("areas");
+        for (sal_uInt16 i = 0, n = rDoc.GetPrintRangeCount(nTab); i < n; ++i)
+            rJson.putSimpleValue(rDoc.GetPrintRange(nTab, i)->Format(rDoc, ScRefFlags::RANGE_ABS, aDetails));
+    }
+    lcl_PutSpan(rJson, "rows", rDoc.GetRepeatRowRange(nTab), true);
+    lcl_PutSpan(rJson, "columns", rDoc.GetRepeatColRange(nTab), false);
+    rJson.put("rowBreak", bool(rDoc.HasRowBreak(rCursor.Row(), nTab) & ScBreakType::Manual));
+    rJson.put("columnBreak", bool(rDoc.HasColBreak(rCursor.Col(), nTab) & ScBreakType::Manual));
+    const OUString aStyle = rDoc.GetPageStyle(nTab);
+    SfxStyleSheetBase* pStyle = rDoc.GetStyleSheetPool()->Find(aStyle, SfxStyleFamily::Page);
+    if (!pStyle)
+        return;
+    const SfxItemSet& rSet = pStyle->GetItemSet();
+    rJson.put("landscape", rSet.Get(ATTR_PAGE).IsLandscape());
+    rJson.put("scale", rSet.Get(ATTR_PAGE_SCALE).GetValue());
+    rJson.put("pages", rSet.Get(ATTR_PAGE_SCALETOPAGES).GetValue());
+    rJson.put("fitWidth", rSet.Get(ATTR_PAGE_SCALETO).GetWidth());
+    rJson.put("fitHeight", rSet.Get(ATTR_PAGE_SCALETO).GetHeight());
+    // Every sheet the page style governs.
+    auto aSheets = rJson.startArray("sheets");
+    for (SCTAB i = 0; i < rDoc.GetTableCount(); ++i)
+    {
+        OUString aName;
+        if (rDoc.GetPageStyle(i) == aStyle && rDoc.GetName(i, aName))
+            rJson.putSimpleValue(aName);
+    }
+}
