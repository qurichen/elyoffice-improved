+/// Slides per handout page asked; 0 is none.
+sal_Int32 lcl_Handouts(const uno::Sequence<beans::PropertyValue>& rOptions)
+{
+    sal_Int32 nPer = 0;
+    for (const auto& rOption : rOptions)
+        if (rOption.Name == "ExportHandouts")
+            rOption.Value >>= nPer;
+    return nPer;
+}
+
+/// The shown slides in the options' range.
+std::vector<sal_uInt16> lcl_HandoutSlides(SdDrawDocument& rDoc, const uno::Sequence<beans::PropertyValue>& rOptions)
+{
+    const sal_uInt16 nCount = rDoc.GetSdPageCount(PageKind::Standard);
+    OUString aRange;
+    for (const auto& rOption : rOptions)
+        if (rOption.Name == "PageRange")
+            rOption.Value >>= aRange;
+    if (aRange.isEmpty())
+        aRange = "1-" + OUString::number(nCount);
+    std::vector<sal_uInt16> aSlides;
+    for (sal_Int32 nAt : StringRangeEnumerator(aRange, 0, nCount - 1))
+        if (!rDoc.GetSdPage(nAt, PageKind::Standard)->IsExcluded())
+            aSlides.push_back(nAt);
+    return aSlides;
+}
+
+/// Lays out the handout page as printing does.
+bool lcl_HandoutTemplate(SdDrawDocument& rDoc, sal_Int32 nPer)
+{
+    AutoLayout eLayout = AUTOLAYOUT_NONE;
+    switch (nPer)
+    {
+        case 1: eLayout = AUTOLAYOUT_HANDOUT1; break;
+        case 2: eLayout = AUTOLAYOUT_HANDOUT2; break;
+        case 3: eLayout = AUTOLAYOUT_HANDOUT3; break;
+        case 4: eLayout = AUTOLAYOUT_HANDOUT4; break;
+        case 6: eLayout = AUTOLAYOUT_HANDOUT6; break;
+        case 9: eLayout = AUTOLAYOUT_HANDOUT9; break;
+        default: return false;
+    }
+    SdPage* pHandout = rDoc.GetSdPage(0, PageKind::Handout);
+    if (!pHandout)
+        return false;
+    while (pHandout->GetObjCount())
+        pHandout->NbcRemoveObject(0);
+    const Size aSize = pHandout->GetSize();
+    std::vector<::tools::Rectangle> aAreas;
+    SdPage::CalculateHandoutAreas(rDoc, eLayout, false, aAreas,
+        aSize.Width() > aSize.Height() ? Orientation::Landscape : Orientation::Portrait);
+    for (auto it = aAreas.begin(); it != aAreas.end();)
+    {
+        pHandout->NbcInsertObject(new SdrPageObj(rDoc, *it++));
+        // Three a page leave lines for notes.
+        if (eLayout != AUTOLAYOUT_HANDOUT3 || it == aAreas.end())
+            continue;
+        const ::tools::Rectangle aRect(*it++);
+        basegfx::B2DPolygon aLine;
+        aLine.append(basegfx::B2DPoint(aRect.Left(), aRect.Top()));
+        aLine.append(basegfx::B2DPoint(aRect.Right(), aRect.Top()));
+        basegfx::B2DHomMatrix aStep;
+        aStep.translate(0.0, static_cast<double>(aRect.GetHeight() / 7));
+        basegfx::B2DPolyPolygon aLines;
+        for (int n = 0; n < 7; ++n)
+        {
+            aLine.transform(aStep);
+            aLines.append(aLine);
+        }
+        rtl::Reference<SdrPathObj> pPath = new SdrPathObj(rDoc, SdrObjKind::PathLine, std::move(aLines));
+        pPath->SetMergedItem(XLineStyleItem(drawing::LineStyle_SOLID));
+        pPath->SetMergedItem(XLineColorItem(OUString(), COL_BLACK));
+        pHandout->NbcInsertObject(pPath.get());
+    }
+    return true;
+}
+
+/// Shows handout page `nPage` of `rSlides`; empty frames hide.
+void lcl_HandoutPage(SdDrawDocument& rDoc, const std::vector<sal_uInt16>& rSlides, sal_Int32 nPage)
+{
+    SdPage& rHandout = *rDoc.GetSdPage(0, PageKind::Handout);
+    std::vector<SdrPageObj*> aFrames;
+    for (const rtl::Reference<SdrObject>& pObj : rHandout)
+        if (auto pFrame = dynamic_cast<SdrPageObj*>(pObj.get()))
+            aFrames.push_back(pFrame);
+    for (size_t n = 0; n < aFrames.size(); ++n)
+    {
+        const size_t nAt = nPage * aFrames.size() + n;
+        aFrames[n]->SetReferencedPage(nAt < rSlides.size()
+            ? rDoc.GetSdPage(rSlides[nAt], PageKind::Standard) : nullptr);
+    }
+}
+}
