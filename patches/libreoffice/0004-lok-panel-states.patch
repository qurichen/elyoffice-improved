+
+// Page margins in 1/100 mm: "left,right" or "upper,lower".
+OString MarginsPayload(sal_uInt16, SfxViewFrame*, const css::frame::FeatureStateEvent& aEvent,
+                       const SfxPoolItem*)
+{
+    OString aCommand = aEvent.FeatureURL.Complete.toUtf8() + "=";
+    if (css::frame::status::LeftRightMargin aLR; aEvent.State >>= aLR)
+        return aCommand + OString::number(aLR.Left) + "," + OString::number(aLR.Right);
+    if (css::frame::status::UpperLowerMargin aUL; aEvent.State >>= aUL)
+        return aCommand + OString::number(aUL.Upper) + "," + OString::number(aUL.Lower);
+    return aCommand;
+}
+
+// The page item: "landscape,layout,numtype".
+OString PageItemPayload(sal_uInt16, SfxViewFrame*, const css::frame::FeatureStateEvent& aEvent,
+                        const SfxPoolItem* pState)
+{
+    OString aCommand = aEvent.FeatureURL.Complete.toUtf8() + "=";
+    if (!pState || IsInvalidItem(pState) || IsDisabledItem(pState))
+        return aCommand;
+    // Member ids of SvxPageItem, as svx/unomid.hxx defines them.
+    constexpr sal_uInt8 MID_PAGE_NUMTYPE = 0, MID_PAGE_ORIENTATION = 1, MID_PAGE_LAYOUT = 2;
+    css::uno::Any aLandscape, aLayout, aNumType;
+    bool bLandscape = false;
+    css::style::PageStyleLayout eLayout = css::style::PageStyleLayout_ALL;
+    sal_Int16 nNumType = 0;
+    if (!pState->QueryValue(aLandscape, MID_PAGE_ORIENTATION) || !(aLandscape >>= bLandscape)
+        || !pState->QueryValue(aLayout, MID_PAGE_LAYOUT) || !(aLayout >>= eLayout)
+        || !pState->QueryValue(aNumType, MID_PAGE_NUMTYPE) || !(aNumType >>= nNumType))
+        return aCommand;
+    return aCommand + OString::boolean(bLandscape) + "," + OString::number(sal_Int32(eLayout))
+           + "," + OString::number(nNumType);
 }
 
