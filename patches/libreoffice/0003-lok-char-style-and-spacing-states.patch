+// Spacing above and below in 1/100 mm: "upper,lower".
+OString ULSpacingPayload(sal_uInt16, SfxViewFrame*, const css::frame::FeatureStateEvent& aEvent,
+                         const SfxPoolItem*)
+{
+    css::frame::status::UpperLowerMarginScale aMargin;
+    if (!(aEvent.State >>= aMargin))
+        return aEvent.FeatureURL.Complete.toUtf8() + "=";
+    return aEvent.FeatureURL.Complete.toUtf8() + "=" + OString::number(aMargin.Upper) + ","
+           + OString::number(aMargin.Lower);
+}
