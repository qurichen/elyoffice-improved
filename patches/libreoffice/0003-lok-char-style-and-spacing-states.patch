 using namespace ::com::sun::star;
 
+// LOK: whether the selection spans paragraph styles.
+static bool lcl_MixedColl(SwWrtShell& rShell, const SwTextFormatColl& rColl)
+{
+    for (SwPaM& rPaM : rShell.GetCursor()->GetRingContainer())
+    {
+        for (SwNodeOffset n = rPaM.Start()->GetNodeIndex(); n <= rPaM.End()->GetNodeIndex(); ++n)
+        {
+            SwNode* pNode = rShell.GetDoc()->GetNodes()[n];
+            if (pNode->IsTextNode()
+                && sw::GetParaPropsNode(*rShell.GetLayout(), *pNode)->GetTextColl() != &rColl)
+                return true;
+        }
+    }
+    return false;
+}
