macOS Skia: no unused font manager on the first text draw

AquaSkiaSalGraphicsImpl::drawTextLayout built a static SkFontMgr from a
fresh CoreText list of every system font the first time it drew text.
Nothing reads it: the typeface comes from the CTFont itself. Building
it enumerated and sorted all system fonts on the main thread, about
175 ms with 370 fonts, so the first character typed into a new
document (or the first text painted) landed late.

diff --git a/vcl/inc/skia/osx/gdiimpl.hxx b/vcl/inc/skia/osx/gdiimpl.hxx
index 6e1656e59..29aa5a46e 100644
--- a/vcl/inc/skia/osx/gdiimpl.hxx
+++ b/vcl/inc/skia/osx/gdiimpl.hxx
@@ -16,7 +16,6 @@
 #include <skia/gdiimpl.hxx>
 #include <skia/utils.hxx>
 
-#include <SkFontMgr.h>
 
 class VCL_PLUGIN_PUBLIC AquaSkiaSalGraphicsImpl final : public SkiaSalGraphicsImpl,
                                                         public AquaGraphicsBackendBase
@@ -48,7 +47,6 @@ private:
     virtual int getWindowScaling() const override;
     virtual void createWindowSurfaceInternal(bool forceRaster = false) override;
     virtual void flushSurfaceToWindowContext() override;
-    static inline sk_sp<SkFontMgr> fontManager;
 };
 
