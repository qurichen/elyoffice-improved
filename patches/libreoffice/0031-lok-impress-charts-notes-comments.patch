+/// The one marked chart's name, look and data; nothing otherwise.
+void lcl_Chart(::tools::JsonWriter& rJson, sd::View& rView)
+{
+    const SdrMarkList& rMarks = rView.GetMarkedObjectList();
+    auto pOle = rMarks.GetMarkCount() == 1
+        ? dynamic_cast<SdrOle2Obj*>(rMarks.GetMark(0)->GetMarkedSdrObj()) : nullptr;
+    if (!pOle || !pOle->IsChart())
+        return;
+    const uno::Reference<uno::XInterface> xModel = pOle->getXModel();
+    rJson.put("name", pOle->GetName());
+    ChartHelper::WriteChartLook(rJson, xModel);
+    ChartHelper::WriteChartData(rJson, xModel);
+}
+
+/// The shown slide's notes as text; rich with character formats.
+void lcl_SlideNotes(::tools::JsonWriter& rJson, SdDrawDocument& rDoc, sd::DrawViewShell& rShell)
+{
+    SdPage* pPage = rShell.GetActualPage();
+    SdPage* pNotes = pPage->IsMasterPage()
+        ? nullptr : rDoc.GetSdPage((pPage->GetPageNum() - 1) / 2, PageKind::Notes);
+    auto pObj = pNotes ? dynamic_cast<SdrTextObj*>(pNotes->GetPresObj(PresObjKind::Notes)) : nullptr;
+    rJson.put("part", pPage->IsMasterPage() ? sal_Int32(-1) : sal_Int32((pPage->GetPageNum() - 1) / 2));
+    rJson.put("editable", pObj != nullptr);
+    const OutlinerParaObject* pText = pObj && !pObj->IsEmptyPresObj() ? pObj->GetOutlinerParaObject() : nullptr;
+    rJson.put("text", pText ? pText->GetTextObject().GetText(LINEEND_LF) : OUString());
+    rJson.put("rich", pText && !sd::DrawViewShell::NotesLook(pText->GetTextObject(), rDoc.GetPool()));
+}
