+std::optional<SfxItemSet> DrawViewShell::NotesLook(const EditTextObject& rText, SfxItemPool& rPool)
+{
+    std::optional<SfxItemSet> oPara, oChar;
+    for (sal_Int32 i = 0; i < rText.GetParagraphCount(); ++i)
+    {
+        SfxItemSet aPara(rPool, svl::Items<EE_PARA_START, EE_PARA_END>);
+        aPara.Put(rText.GetParaAttribs(i));
+        // The outliner keeps this one itself.
+        aPara.ClearItem(EE_PARA_BULLETSTATE);
+        if (oPara && *oPara != aPara)
+            return {};
+        oPara.emplace(aPara);
+        const sal_Int32 nLen = rText.GetText(i).getLength();
+        if (!nLen)
+            continue;
+        SfxItemSet aChar(rPool, svl::Items<EE_CHAR_START, EE_CHAR_END>);
+        std::vector<EECharAttrib> aAttribs;
+        rText.GetCharAttribs(i, aAttribs);
+        for (const EECharAttrib& rAttrib : aAttribs)
+        {
+            if (rAttrib.nStart == rAttrib.nEnd)
+                continue;
+            if (rAttrib.nStart > 0 || rAttrib.nEnd < nLen)
+                return {};
+            aChar.Put(*rAttrib.pAttr);
+        }
+        if (oChar && *oChar != aChar)
+            return {};
+        oChar.emplace(aChar);
+    }
+    SfxItemSet aLook(rPool, svl::Items<EE_PARA_START, EE_CHAR_END>);
+    if (oPara)
+        aLook.Put(*oPara);
+    if (oChar)
+        aLook.Put(*oChar);
+    return aLook;
+}
