+/// Sets the marked chart from JSON via a copy.
+bool FuInsertOLE::ChangeChart(std::u16string_view rJson)
+{
+    const SdrMarkList& rMarks = mpView->GetMarkedObjectList();
+    if (rMarks.GetMarkCount() != 1)
+        return false;
+    SdrOle2Obj* pOld = dynamic_cast<SdrOle2Obj*>(rMarks.GetMark(0)->GetMarkedSdrObj());
+    if (!pOld || !pOld->IsChart())
+        return false;
+    rtl::Reference<SdrObject> pNew = pOld->CloneSdrObject(pOld->getSdrModelFromSdrObject());
+    const uno::Reference<uno::XInterface> xModel = static_cast<SdrOle2Obj&>(*pNew).getXModel();
+    // The look first: data reads its type.
+    if (!ChartHelper::SetChartLook(xModel, rJson) || !ChartHelper::SetChartData(xModel, rJson))
+        return false;
+    mpView->ReplaceObjectAtView(pOld, *mpView->GetSdrPageView(), pNew.get());
+    return true;
+}
