+bool SdXImpressDocument::supportsCommand(std::u16string_view rCommand)
+{
+    return rCommand == u"SlideDesign";
+}
+
+namespace
+{
+/// Masters, color sets, and the shown slide's design.
+void lcl_SlideDesign(::tools::JsonWriter& rJson, SdDrawDocument& rDoc, sd::DrawViewShell& rShell)
+{
+    SdPage* pPage = rShell.GetActualPage();
+    const SdPage& rMaster = pPage->IsMasterPage() ? *pPage : static_cast<const SdPage&>(pPage->TRG_GetMasterPage());
+    {
+        auto aMasters = rJson.startArray("masters");
+        for (sal_uInt16 i = 0; i < rDoc.GetMasterSdPageCount(PageKind::Standard); ++i)
+            rJson.putSimpleValue(rDoc.GetMasterSdPage(i, PageKind::Standard)->GetName());
+    }
+    rJson.put("master", rMaster.GetName());
+    rJson.put("masterView", rShell.GetEditMode() == EditMode::MasterPage);
+    rJson.put("layout", static_cast<sal_Int32>(pPage->GetAutoLayout()));
+    const auto& pTheme = rMaster.getSdrPageProperties().getTheme();
+    const auto pSet = pTheme ? pTheme->getColorSet() : nullptr;
+    rJson.put("theme", pSet ? pSet->getName() : OUString());
+    auto aThemes = rJson.startArray("themes");
+    for (const model::ColorSet& rSet : svx::ColorSets::get().getColorSetVector())
+        rJson.putSimpleValue(rSet.getName());
+}
+}
