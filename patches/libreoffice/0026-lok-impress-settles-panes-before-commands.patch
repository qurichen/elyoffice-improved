+void SdXImpressDocument::settleViews()
+{
+    // Pane changes are queued; their shells serve the slots.
+    if (DrawViewShell* pViewSh = GetViewShell())
+        sd::framework::FrameworkHelper::Instance(pViewSh->GetViewShellBase())->RequestSynchronousUpdate();
+}
