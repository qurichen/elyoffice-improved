diff --git a/configure.ac b/configure.ac
index 9f67ee4..6ba256f 100644
--- a/configure.ac
+++ b/configure.ac
@@ -15950,7 +15950,18 @@ dnl ===================================================================
 dnl Checking for active Antivirus software.
 dnl ===================================================================
 
-if test $_os = WINNT -a -f "$SRC_ROOT/antivirusDetection.vbs" ; then
+AC_ARG_ENABLE([antivirus-check],
+    AS_HELP_STRING([--disable-antivirus-check],
+        [Skip the build-directory antivirus probe; keep system protection unchanged.]),
+    [], [enable_antivirus_check=yes])
+case "$enable_antivirus_check" in
+    yes|no) ;;
+    *) AC_MSG_ERROR([--enable-antivirus-check accepts only yes or no]) ;;
+esac
+if test "$enable_antivirus_check" = no; then
+    AC_MSG_NOTICE([Antivirus build-directory probe explicitly skipped; system protection is unchanged.])
+fi
+if test "$enable_antivirus_check" = yes -a $_os = WINNT -a -f "$SRC_ROOT/antivirusDetection.vbs" ; then
     AC_MSG_CHECKING([for active Antivirus software])
     PathFormat "$SRC_ROOT/antivirusDetection.vbs"
     ANTIVIRUS_LIST=`cscript.exe //Nologo ${formatted_path}`
