+/// Files and sources whose data the workbook shows as saved.
+void lcl_ExternalLinks(tools::JsonWriter& rJson, ScDocument& rDoc)
+{
+    std::set<OUString> aSources;
+    ScExternalRefManager* pRefs = rDoc.GetExternalRefManager();
+    for (sal_uInt16 i = 0, n = pRefs->getExternalFileCount(); i < n; ++i)
+        if (const OUString* pName = pRefs->getExternalFileName(i, true))
+            aSources.insert(*pName);
+    if (sfx2::LinkManager* pLinks = rDoc.GetDocLinkManager().getLinkManager(false))
+    {
+        for (const auto& rLink : pLinks->GetLinks())
+        {
+            if (auto pArea = dynamic_cast<const ScAreaLink*>(rLink.get()))
+                aSources.insert(pArea->GetFile());
+            else if (auto pTable = dynamic_cast<const ScTableLink*>(rLink.get()))
+                aSources.insert(pTable->GetFileName());
+            else if (auto pDde = dynamic_cast<const ScDdeLink*>(rLink.get()))
+                aSources.insert(pDde->GetAppl() + "|" + pDde->GetTopic());
+            else if (auto pWeb = dynamic_cast<const ScWebServiceLink*>(rLink.get()))
+                aSources.insert(pWeb->GetURL());
+        }
+    }
+    auto aArray = rJson.startArray("links");
+    for (const OUString& rSource : aSources)
+        rJson.putSimpleValue(rSource);
+}
