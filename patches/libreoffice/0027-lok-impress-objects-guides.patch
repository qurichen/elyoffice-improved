+// LOK adds, moves or deletes a guide without the dialog.
+void FuSnapLine::DoLokExecute(SfxRequest& rReq, const SfxUInt32Item* pIndex, SdrPageView& rPV)
+{
+    const SfxUInt16Item* pKind = rReq.GetArg<SfxUInt16Item>(FN_PARAM_1);
+    const SfxInt32Item* pX = rReq.GetArg<SfxInt32Item>(FN_PARAM_2);
+    const SfxInt32Item* pY = rReq.GetArg<SfxInt32Item>(FN_PARAM_3);
+    const SfxBoolItem* pDelete = rReq.GetArg<SfxBoolItem>(FN_PARAM_4);
+    const SdrHelpLineList& rLines = rPV.GetHelpLines();
+    if (pIndex && pIndex->GetValue() >= rLines.GetCount())
+        return;
+    if (pIndex && pDelete && pDelete->GetValue())
+    {
+        rPV.DeleteHelpLine(pIndex->GetValue());
+        rReq.Done();
+        return;
+    }
+    if (!pX || !pY || (!pIndex && !pKind))
+        return;
+    Point aPos(pX->GetValue(), pY->GetValue());
+    rPV.PagePosToLogic(aPos);
+    if (pIndex)
+    {
+        const sal_uInt16 nLine = pIndex->GetValue();
+        rPV.SetHelpLine(nLine, SdrHelpLine(rLines[nLine].GetKind(), aPos));
+    }
+    else
+    {
+        SdrHelpLineKind eKind = SdrHelpLineKind::Point;
+        if (static_cast<SnapKind>(pKind->GetValue()) == SnapKind::Horizontal)
+            eKind = SdrHelpLineKind::Horizontal;
+        else if (static_cast<SnapKind>(pKind->GetValue()) == SnapKind::Vertical)
+            eKind = SdrHelpLineKind::Vertical;
+        rPV.InsertHelpLine(SdrHelpLine(eKind, aPos));
+    }
+    rReq.Done();
+}
