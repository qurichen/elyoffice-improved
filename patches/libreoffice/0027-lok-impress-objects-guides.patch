+/// What an object is, as Ely names it.
+std::string_view lcl_ObjectKind(const SdrObject& rObj)
+{
+    if (rObj.GetObjInventor() != SdrInventor::Default)
+        return "other";
+    switch (rObj.GetObjIdentifier())
+    {
+        case SdrObjKind::Group: return "group";
+        case SdrObjKind::Line:
+        case SdrObjKind::PolyLine:
+        case SdrObjKind::PathLine:
+        case SdrObjKind::FreehandLine:
+        case SdrObjKind::Measure: return "line";
+        case SdrObjKind::Edge: return "connector";
+        case SdrObjKind::Graphic: return "image";
+        case SdrObjKind::Table: return "table";
+        case SdrObjKind::OLE2:
+            return static_cast<const SdrOle2Obj&>(rObj).IsChart() ? "chart" : "object";
+        case SdrObjKind::Media: return "media";
+        case SdrObjKind::Text:
+        case SdrObjKind::TitleText:
+        case SdrObjKind::OutlineText: return "text";
+        default: return "shape";
+    }
+}
+
+/// A placeholder's role; empty for none.
+std::string_view lcl_Placeholder(PresObjKind eKind)
+{
+    switch (eKind)
+    {
+        case PresObjKind::NONE: return "";
+        case PresObjKind::Title: return "title";
+        case PresObjKind::Outline:
+        case PresObjKind::Text: return "body";
+        default: return "other";
+    }
+}
+
+/// A color, `-1` for none, `-2` for mixed.
+sal_Int32 lcl_Color(const SfxItemSet& rAttr, sal_uInt16 nStyle, sal_uInt16 nColor, bool bLine)
+{
+    if (rAttr.GetItemState(nStyle) == SfxItemState::INVALID)
+        return -2;
+    const bool bNone = bLine
+        ? rAttr.Get(XATTR_LINESTYLE).GetValue() == css::drawing::LineStyle_NONE
+        : rAttr.Get(XATTR_FILLSTYLE).GetValue() != css::drawing::FillStyle_SOLID;
+    if (bNone)
+        return -1;
+    if (rAttr.GetItemState(nColor) == SfxItemState::INVALID)
+        return -2;
+    return sal_Int32(static_cast<const XColorItem&>(rAttr.Get(nColor)).GetColorValue().GetRGBColor());
+}
+
+/// A flag: `0`, `1`, or `-2` for mixed.
+sal_Int32 lcl_Flag(const SfxItemSet& rAttr, sal_uInt16 nWhich)
+{
+    if (rAttr.GetItemState(nWhich) == SfxItemState::INVALID)
+        return -2;
+    return static_cast<const SfxBoolItem&>(rAttr.Get(nWhich)).GetValue() ? 1 : 0;
+}
+
+/// The marked objects' kind, look and geometry.
+void lcl_Selection(::tools::JsonWriter& rJson, sd::View& rView)
+{
+    const SdrMarkList& rMarks = rView.GetMarkedObjectList();
+    auto aNode = rJson.startNode("selection");
+    rJson.put("count", static_cast<sal_Int32>(rMarks.GetMarkCount()));
+    if (!rMarks.GetMarkCount())
+        return;
+    std::string_view aKind = lcl_ObjectKind(*rMarks.GetMark(0)->GetMarkedSdrObj());
+    for (size_t i = 1; i < rMarks.GetMarkCount(); ++i)
+        if (lcl_ObjectKind(*rMarks.GetMark(i)->GetMarkedSdrObj()) != aKind)
+            aKind = "mixed";
+    rJson.put("kind", aKind);
+    rJson.put("canGroup", rView.IsGroupPossible());
+    rJson.put("canUngroup", rView.IsUnGroupPossible());
+    const SfxItemSet aAttr(rView.GetAttrFromMarked(false));
+    rJson.put("fill", lcl_Color(aAttr, XATTR_FILLSTYLE, XATTR_FILLCOLOR, false));
+    rJson.put("line", lcl_Color(aAttr, XATTR_LINESTYLE, XATTR_LINECOLOR, true));
+    rJson.put("lineWidth", aAttr.GetItemState(XATTR_LINEWIDTH) == SfxItemState::INVALID
+        ? sal_Int32(-2) : sal_Int32(aAttr.Get(XATTR_LINEWIDTH).GetValue()));
+    rJson.put("transparency", aAttr.GetItemState(XATTR_FILLTRANSPARENCE) == SfxItemState::INVALID
+        ? sal_Int32(-2) : sal_Int32(aAttr.Get(XATTR_FILLTRANSPARENCE).GetValue()));
+    rJson.put("shadow", lcl_Flag(aAttr, SDRATTR_SHADOW));
+    std::string_view aFit = "mixed";
+    if (aAttr.GetItemState(SDRATTR_TEXT_FITTOSIZE) != SfxItemState::INVALID
+        && aAttr.GetItemState(SDRATTR_TEXT_AUTOGROWHEIGHT) != SfxItemState::INVALID)
+    {
+        aFit = aAttr.Get(SDRATTR_TEXT_FITTOSIZE).GetValue() == css::drawing::TextFitToSizeType_AUTOFIT
+            ? "shrink" : aAttr.Get(SDRATTR_TEXT_AUTOGROWHEIGHT).GetValue() ? "grow" : "off";
+    }
+    rJson.put("autofit", aFit);
+    const SfxItemSet aGeo(rView.GetGeoAttrFromMarked());
+    rJson.put("x", aGeo.Get(SID_ATTR_TRANSFORM_POS_X).GetValue());
+    rJson.put("y", aGeo.Get(SID_ATTR_TRANSFORM_POS_Y).GetValue());
+    rJson.put("width", sal_Int64(aGeo.Get(SID_ATTR_TRANSFORM_WIDTH).GetValue()));
+    rJson.put("height", sal_Int64(aGeo.Get(SID_ATTR_TRANSFORM_HEIGHT).GetValue()));
+    rJson.put("rotation", sal_Int32(aGeo.Get(SID_ATTR_TRANSFORM_ANGLE).GetValue().get()));
+    rJson.put("rotationX", aGeo.Get(SID_ATTR_TRANSFORM_ROT_X).GetValue());
+    rJson.put("rotationY", aGeo.Get(SID_ATTR_TRANSFORM_ROT_Y).GetValue());
+    rJson.put("lockPosition", lcl_Flag(aGeo, SID_ATTR_TRANSFORM_PROTECT_POS));
+    rJson.put("lockSize", lcl_Flag(aGeo, SID_ATTR_TRANSFORM_PROTECT_SIZE));
+}
+
+/// The shown slide's objects, selection, guides and snapping.
+void lcl_SlideObjects(::tools::JsonWriter& rJson, sd::DrawViewShell& rShell)
+{
+    sd::View& rView = *rShell.GetView();
+    SdrPageView* pPV = rView.GetSdrPageView();
+    SdPage* pPage = rShell.GetActualPage();
+    const SdrMarkList& rMarks = rView.GetMarkedObjectList();
+    {
+        auto aObjects = rJson.startArray("objects");
+        for (const rtl::Reference<SdrObject>& pObj : *pPage)
+        {
+            // Comments have their own list.
+            if (pObj->isAnnotationObject())
+                continue;
+            auto aObject = rJson.startStruct();
+            ::tools::Rectangle aRect(pObj->GetSnapRect());
+            pPV->LogicToPagePos(aRect);
+            rJson.put("name", pObj->GetName());
+            rJson.put("kind", lcl_ObjectKind(*pObj));
+            rJson.put("placeholder", lcl_Placeholder(pPage->GetPresObjKind(pObj.get())));
+            rJson.put("x", sal_Int64(aRect.Left()));
+            rJson.put("y", sal_Int64(aRect.Top()));
+            rJson.put("width", sal_Int64(aRect.GetWidth()));
+            rJson.put("height", sal_Int64(aRect.GetHeight()));
+            rJson.put("locked", pObj->IsMoveProtect());
+            rJson.put("selected", rMarks.FindObject(pObj.get()) != SAL_MAX_SIZE);
+        }
+    }
+    lcl_Selection(rJson, rView);
+    rJson.put("snapGrid", rView.IsGridSnap());
+    rJson.put("snapGuides", rView.IsHlplSnap());
+    auto aGuides = rJson.startArray("guides");
+    const SdrHelpLineList& rLines = pPV->GetHelpLines();
+    for (sal_uInt16 i = 0; i < rLines.GetCount(); ++i)
+    {
+        auto aGuide = rJson.startStruct();
+        Point aPos(rLines[i].GetPos());
+        pPV->LogicToPagePos(aPos);
+        const SdrHelpLineKind eKind = rLines[i].GetKind();
+        rJson.put("kind", eKind == SdrHelpLineKind::Horizontal ? "horizontal"
+                          : eKind == SdrHelpLineKind::Vertical ? "vertical" : "point");
+        rJson.put("x", sal_Int64(aPos.X()));
+        rJson.put("y", sal_Int64(aPos.Y()));
+    }
+}
