+/// The shown slide's media: list place, file, link.
+void lcl_SlideMedia(::tools::JsonWriter& rJson, sd::DrawViewShell& rShell)
+{
+    sal_Int64 nAt = 0;
+    auto aList = rJson.startArray("media");
+    for (const rtl::Reference<SdrObject>& pObj : *rShell.GetActualPage())
+    {
+        if (pObj->isAnnotationObject())
+            continue;
+        if (auto pMedia = dynamic_cast<const SdrMediaObj*>(pObj.get()))
+        {
+            const avmedia::MediaItem& rItem = pMedia->getMediaProperties();
+            const bool bLink = !rItem.getURL().startsWithIgnoreAsciiCase("vnd.sun.star.Package:");
+            // Links play their file; embedded media a temp copy.
+            const OUString aFile = bLink ? rItem.getURL() : rItem.getTempURL();
+            osl::DirectoryItem aItem;
+            auto aOne = rJson.startStruct();
+            rJson.put("index", nAt);
+            rJson.put("url", rItem.getURL());
+            rJson.put("link", bLink);
+            rJson.put("file", aFile);
+            rJson.put("missing", aFile.isEmpty() || osl::DirectoryItem::get(aFile, aItem) != osl::FileBase::E_None);
+            rJson.put("loop", rItem.isLoop());
+        }
+        ++nAt;
+    }
+}
