+namespace
+{
+/// A chart's whole diagram and main title, cloned.
+struct ChartState
+{
+    uno::Reference<chart2::XDiagram> xDiagram;
+    uno::Reference<chart2::XTitle> xTitle;
+};
+
+template <class T> uno::Reference<T> lcl_Clone(const uno::Reference<T>& xFrom)
+{
+    uno::Reference<util::XCloneable> xCloneable(xFrom, uno::UNO_QUERY);
+    return xCloneable.is() ? uno::Reference<T>(xCloneable->createClone(), uno::UNO_QUERY_THROW)
+                           : uno::Reference<T>();
+}
+
+ChartState lcl_ChartState(const uno::Reference<chart2::XChartDocument>& xChart)
+{
+    uno::Reference<chart2::XTitled> xTitled(xChart, uno::UNO_QUERY_THROW);
+    return { lcl_Clone(xChart->getFirstDiagram()), lcl_Clone(xTitled->getTitleObject()) };
+}
+
+/// Undoes a chart's look by putting its whole diagram back.
+class ScUndoChartLook : public ScSimpleUndo
+{
+    OUString maName;
+    ChartState maOld, maNew;
+
+    void Apply(const ChartState& rState)
+    {
+        auto xChart = rDocShell.GetDocument().GetChartByName(maName);
+        uno::Reference<chart2::XTitled> xTitled(xChart, uno::UNO_QUERY_THROW);
+        xChart->setFirstDiagram(lcl_Clone(rState.xDiagram));
+        xTitled->setTitleObject(lcl_Clone(rState.xTitle));
+    }
+
+public:
+    ScUndoChartLook(ScDocShell& rShell, OUString aName, ChartState aOld, ChartState aNew)
+        : ScSimpleUndo(rShell)
+        , maName(std::move(aName))
+        , maOld(std::move(aOld))
+        , maNew(std::move(aNew))
+    {
+    }
+    void Undo() override
+    {
+        BeginUndo();
+        Apply(maOld);
+        EndUndo();
+    }
+    void Redo() override
+    {
+        BeginRedo();
+        Apply(maNew);
+        EndRedo();
+    }
+    void Repeat(SfxRepeatTarget&) override {}
+    bool CanRepeat(SfxRepeatTarget&) const override { return false; }
+    OUString GetComment() const override { return ScResId(STR_UNDO_CHARTDATA); }
+};
+}
