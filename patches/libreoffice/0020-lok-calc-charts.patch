+/// The one selected chart: name, data range, headers, look.
+void lcl_Chart(tools::JsonWriter& rJson, ScDocument& rDoc, ScViewData& rData)
+{
+    rJson.put("commandName", ".uno:Chart");
+    const ScDrawView* pView = rData.GetViewShell()->GetScDrawView();
+    if (!pView || pView->GetMarkedObjectList().GetMarkCount() != 1)
+        return;
+    const auto* pObj = dynamic_cast<const SdrOle2Obj*>(pView->GetMarkedObjectList().GetMark(0)->GetMarkedSdrObj());
+    if (!pObj || !pObj->IsChart())
+        return;
+    const OUString aName = pObj->GetPersistName();
+    ScRangeList aRanges;
+    bool bColHeaders = false, bRowHeaders = false;
+    rDoc.GetOldChartParameters(aName, aRanges, bColHeaders, bRowHeaders);
+    OUString aRange;
+    aRanges.Format(aRange, ScRefFlags::RANGE_ABS_3D, rDoc, rDoc.GetAddressConvention());
+    rJson.put("name", aName);
+    rJson.put("range", aRange);
+    rJson.put("colHeaders", bColHeaders);
+    rJson.put("rowHeaders", bRowHeaders);
+    sctools::writeChartLook(rJson, rDoc.GetChartByName(aName));
+}
