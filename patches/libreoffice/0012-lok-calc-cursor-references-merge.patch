+namespace
+{
+/// Whether rCode at rPos refers to sheet nTab.
+bool lcl_RefersToTab(const ScDocument& rDoc, const ScTokenArray& rCode, const ScAddress& rPos,
+                     SCTAB nTab)
+{
+    for (const formula::FormulaToken* pToken : rCode.References())
+    {
+        if (pToken->GetType() == formula::svSingleRef
+            && pToken->GetSingleRef()->toAbs(rDoc, rPos).Tab() == nTab)
+            return true;
+        if (pToken->GetType() == formula::svDoubleRef)
+        {
+            const ScRange aRange = pToken->GetDoubleRef()->toAbs(rDoc, rPos);
+            if (aRange.aStart.Tab() <= nTab && nTab <= aRange.aEnd.Tab())
+                return true;
+        }
+    }
+    return false;
+}
+
+/// Whether rCode finds its target only when it runs.
+bool lcl_IsDynamic(const ScTokenArray& rCode)
+{
+    formula::FormulaTokenArrayPlainIterator aIter(rCode);
+    for (const formula::FormulaToken* pToken = aIter.First(); pToken; pToken = aIter.Next())
+        if (pToken->GetOpCode() == ocIndirect)
+            return true;
+    return false;
+}
+}
+
+bool ScModelObj::supportsCommand(std::u16string_view rCommand)
+{
+    return rCommand == u"SheetReferences";
+}
+
+void ScModelObj::getCommandValues(tools::JsonWriter& rJsonWriter, std::string_view rCommand)
+{
+    if (!pDocShell || !o3tl::starts_with(rCommand, ".uno:SheetReferences"))
+        return;
+    std::map<OUString, OUString> aMap
+        = SfxLokHelper::parseCommandParameters(OUString::fromUtf8(rCommand));
+    const auto aSheet = aMap.find(u"sheet"_ustr);
+    if (aSheet == aMap.end())
+        return;
+    ScDocument& rDoc = pDocShell->GetDocument();
+    const SCTAB nTab = aSheet->second.toInt32();
+    sal_Int64 nFormulas = 0;
+    sal_Int64 nDynamic = 0;
+    OUString aFirst;
+    for (SCTAB nOther = 0; nOther < rDoc.GetTableCount(); ++nOther)
+    {
+        if (nOther == nTab)
+            continue;
+        ScCellIterator aIter(rDoc, ScRange(0, 0, nOther, rDoc.MaxCol(), rDoc.MaxRow(), nOther));
+        for (bool bHas = aIter.first(); bHas; bHas = aIter.next())
+        {
+            if (aIter.getType() != CELLTYPE_FORMULA)
+                continue;
+            const ScTokenArray& rCode = *aIter.getFormulaCell()->GetCode();
+            if (lcl_IsDynamic(rCode))
+                ++nDynamic;
+            if (!lcl_RefersToTab(rDoc, rCode, aIter.GetPos(), nTab))
+                continue;
+            if (!nFormulas++)
+                aFirst = aIter.GetPos().Format(ScRefFlags::VALID | ScRefFlags::TAB_3D, &rDoc);
+        }
+    }
+    sal_Int64 nNames = 0;
+    auto aCount = [&rDoc, &nNames, &nDynamic, nTab](const ScRangeName* pNames) {
+        if (!pNames)
+            return;
+        for (const auto& [rName, pData] : *pNames)
+        {
+            if (!pData->GetCode())
+                continue;
+            if (lcl_IsDynamic(*pData->GetCode()))
+                ++nDynamic;
+            if (lcl_RefersToTab(rDoc, *pData->GetCode(), pData->GetPos(), nTab))
+                ++nNames;
+        }
+    };
+    aCount(rDoc.GetRangeName());
+    for (SCTAB nOther = 0; nOther < rDoc.GetTableCount(); ++nOther)
+        if (nOther != nTab)
+            aCount(rDoc.GetRangeName(nOther));
+    rJsonWriter.put("commandName", ".uno:SheetReferences");
+    rJsonWriter.put("formulas", nFormulas);
+    rJsonWriter.put("names", nNames);
+    rJsonWriter.put("dynamic", nDynamic);
+    rJsonWriter.put("first", aFirst);
 }
 
