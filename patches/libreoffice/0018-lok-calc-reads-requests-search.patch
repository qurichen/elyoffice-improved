+/// The current cell's validation, as the kit client sets it.
+void lcl_Validation(tools::JsonWriter& rJson, ScDocument& rDoc, const ScAddress& rPos)
+{
+    static const char* const aModes[] = { "any",  "whole", "decimal",    "date",
+                                          "time", "textlength", "list", "custom" };
+    static const std::pair<ScConditionMode, const char*> aOperators[]
+        = { { ScConditionMode::Equal, "equal" },          { ScConditionMode::NotEqual, "notequal" },
+            { ScConditionMode::Less, "less" },            { ScConditionMode::EqLess, "lessequal" },
+            { ScConditionMode::Greater, "greater" },      { ScConditionMode::EqGreater, "greaterequal" },
+            { ScConditionMode::Between, "between" },      { ScConditionMode::NotBetween, "notbetween" } };
+    const sal_uInt32 nIndex = rDoc.GetAttr(rPos, ATTR_VALIDDATA).GetValue();
+    const ScValidationData* pData = nIndex ? rDoc.GetValidationEntry(nIndex) : nullptr;
+    rJson.put("type", pData ? aModes[pData->GetDataMode()] : "any");
+    if (!pData)
+        return;
+    const auto pOperator = std::find_if(std::begin(aOperators), std::end(aOperators),
+                                        [pData](const auto& rPair) { return rPair.first == pData->GetOperation(); });
+    rJson.put("operator", pOperator != std::end(aOperators) ? pOperator->second : "equal");
+    rJson.put("value1", pData->GetExpression(rPos, 0));
+    rJson.put("value2", pData->GetExpression(rPos, 1));
+    rJson.put("dropdown", pData->GetListType() != css::sheet::TableValidationVisibility::INVISIBLE);
+    rJson.put("ignoreBlank", pData->IsIgnoreBlank());
+    OUString aTitle, aMessage;
+    rJson.put("showInput", pData->GetInput(aTitle, aMessage));
+    rJson.put("inputTitle", aTitle);
+    rJson.put("inputMessage", aMessage);
+    ScValidErrorStyle eStyle = SC_VALERR_STOP;
+    rJson.put("showError", pData->GetErrMsg(aTitle, aMessage, eStyle));
+    rJson.put("errorTitle", aTitle);
+    rJson.put("errorMessage", aMessage);
+    rJson.put("errorStyle", eStyle == SC_VALERR_INFO      ? "info"
+                            : eStyle == SC_VALERR_WARNING ? "warning"
+                                                          : "stop");
+}
+
+/// The current cell's number format code and kind.
+void lcl_NumberFormat(tools::JsonWriter& rJson, ScDocument& rDoc, const ScAddress& rPos,
+                      std::string_view rCommand)
+{
+    SvNumberFormatter* pFormatter = rDoc.GetFormatTable();
+    std::map<OUString, OUString> aMap
+        = SfxLokHelper::parseCommandParameters(OUString::fromUtf8(rCommand));
+    if (aMap.count(u"code"_ustr))
+    {
+        bool bThousand, bRed;
+        sal_uInt16 nPrecision, nLeading;
+        rJson.put("valid", pFormatter->GetFormatSpecialInfo(aMap[u"code"_ustr], bThousand, bRed,
+                                                            nPrecision, nLeading) == 0);
+        return;
+    }
+    const sal_uInt32 nIndex = rDoc.GetNumberFormat(rPos.Col(), rPos.Row(), rPos.Tab());
+    const SvNumberformat* pEntry = pFormatter->GetEntry(nIndex);
+    rJson.put("code", pEntry ? pEntry->GetFormatstring() : OUString());
+    static const std::pair<SvNumFormatType, const char*> aTypes[]
+        = { { SvNumFormatType::NUMBER, "number" },     { SvNumFormatType::CURRENCY, "currency" },
+            { SvNumFormatType::PERCENT, "percent" },   { SvNumFormatType::DATE, "date" },
+            { SvNumFormatType::TIME, "time" },         { SvNumFormatType::DATETIME, "datetime" },
+            { SvNumFormatType::SCIENTIFIC, "scientific" }, { SvNumFormatType::FRACTION, "fraction" },
+            { SvNumFormatType::LOGICAL, "boolean" },   { SvNumFormatType::TEXT, "text" } };
+    const SvNumFormatType eType = pEntry ? pEntry->GetMaskedType() : SvNumFormatType::ALL;
+    const auto pType = std::find_if(std::begin(aTypes), std::end(aTypes),
+                                    [eType](const auto& rPair) { return rPair.first == eType; });
+    // General opens each locale's block and reads as a number.
+    const bool bGeneral = !pEntry || nIndex % SV_COUNTRY_LANGUAGE_OFFSET == 0;
+    rJson.put("type", bGeneral ? "general" : pType != std::end(aTypes) ? pType->second : "general");
+}
+
+/// The shown sheet's conditional formats.
+void lcl_ConditionalFormats(tools::JsonWriter& rJson, ScDocument& rDoc, SCTAB nTab)
+{
+    auto aFormats = rJson.startArray("formats");
+    const ScConditionalFormatList* pList = rDoc.GetCondFormList(nTab);
+    if (!pList)
+        return;
+    const ScAddress::Details aDetails(rDoc.GetAddressConvention(), 0, 0);
+    for (const auto& pFormat : *pList)
+    {
+        auto aFormat = rJson.startStruct();
+        rJson.put("key", static_cast<sal_Int64>(pFormat->GetKey()));
+        OUString aRange;
+        pFormat->GetRange().Format(aRange, ScRefFlags::VALID, rDoc, aDetails.eConv);
+        rJson.put("range", aRange);
+        const ScFormatEntry* pEntry = pFormat->size() ? pFormat->GetEntry(0) : nullptr;
+        const ScFormatEntry::Type eType = pEntry ? pEntry->GetType() : ScFormatEntry::Type::Date;
+        rJson.put("kind", eType == ScFormatEntry::Type::Colorscale ? "scale"
+                          : eType == ScFormatEntry::Type::Databar  ? "databar"
+                          : eType == ScFormatEntry::Type::Iconset  ? "iconset"
+                          : eType == ScFormatEntry::Type::Condition || eType == ScFormatEntry::Type::ExtCondition
+                              ? "cell"
+                              : "other");
+        if (eType == ScFormatEntry::Type::Condition || eType == ScFormatEntry::Type::ExtCondition)
+        {
+            const auto* pCondition = static_cast<const ScCondFormatEntry*>(pEntry);
+            rJson.put("style", pCondition->GetStyle());
+            rJson.put("value1", pCondition->GetExpression(pFormat->GetRange().GetTopLeftCorner(), 0));
+        }
+    }
+}
