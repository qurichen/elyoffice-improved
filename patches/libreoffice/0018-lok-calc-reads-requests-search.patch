+/// The cell a `?col=&row=` query names, on the shown sheet.
+bool lcl_QueryCell(std::string_view rCommand, SCCOL& rCol, SCROW& rRow)
+{
+    std::map<OUString, OUString> aMap
+        = SfxLokHelper::parseCommandParameters(OUString::fromUtf8(rCommand));
+    if (!aMap.count(u"col"_ustr) || !aMap.count(u"row"_ustr))
+        return false;
+    rCol = aMap[u"col"_ustr].toInt32();
+    rRow = aMap[u"row"_ustr].toInt32();
+    return true;
+}
+
+/// A filter column's entries, as the kernel menu lists them.
+void lcl_FilterValues(tools::JsonWriter& rJson, ScDocument& rDoc, SCCOL nCol, SCROW nRow, SCTAB nTab)
+{
+    ScFilterEntries aEntries;
+    rDoc.GetFilterEntries(nCol, nRow, nTab, aEntries);
+    std::unordered_set<OUString> aStrings;
+    std::unordered_set<double> aNumbers;
+    bool bNonEmpty = false;
+    bool bFiltered = false;
+    if (const ScDBData* pDBData = rDoc.GetDBAtCursor(nCol, nRow, nTab, ScDBDataPortion::AREA))
+    {
+        ScQueryParam aParam;
+        pDBData->GetQueryParam(aParam);
+        const std::vector<ScQueryEntry*> aFound = aParam.FindAllEntriesByField(nCol);
+        bFiltered = !aFound.empty();
+        bNonEmpty = aFound.size() == 1 && aFound[0]->IsQueryByNonEmpty();
+        for (const ScQueryEntry* pEntry : aFound)
+        {
+            if (bNonEmpty || pEntry->eOp != SC_EQUAL)
+                continue;
+            for (const ScQueryEntry::Item& rItem : pEntry->GetQueryItems())
+            {
+                if (rItem.meType == ScQueryEntry::ByValue)
+                    aNumbers.insert(rItem.mfVal);
+                else
+                    aStrings.insert(rItem.maString.getString());
+            }
+        }
+    }
+    rJson.put("filtered", bFiltered);
+    auto aValues = rJson.startArray("values");
+    for (const ScTypedStrData& rStr : aEntries)
+    {
+        // The rules of ScGridWindow::LaunchAutoFilterMenu.
+        bool bSelected = !rStr.IsHiddenByFilter();
+        if (!aStrings.empty() || !aNumbers.empty())
+            bSelected = aStrings.count(rStr.GetString())
+                        || (rStr.GetStringType() == ScTypedStrData::Value
+                            && (aNumbers.count(rStr.GetValue())
+                                || aNumbers.count(rStr.GetRoundedValue())));
+        else if (bNonEmpty && rStr.GetString().isEmpty())
+            bSelected = false;
+        auto aValue = rJson.startStruct();
+        rJson.put("text", rStr.GetString());
+        rJson.put("hidden", rStr.IsHiddenByFilter());
+        rJson.put("selected", bSelected);
+    }
+}
