+namespace sd
+{
+bool DrawViewShell::KitTransition(std::u16string_view rJson)
+{
+    const std::optional<boost::json::object> oObject = lcl_Object(rJson);
+    if (!oObject)
+        return false;
+    const boost::json::value* pPreset = oObject->if_contains("preset");
+    const boost::json::value* pAdvance = oObject->if_contains("advance");
+    const boost::json::value* pAll = oObject->if_contains("all");
+    const std::optional<double> oDuration = lcl_Number(*oObject, "duration", 2.0);
+    const std::optional<double> oTime = lcl_Number(*oObject, "time", 0.0);
+    if (!pPreset || !pPreset->is_string() || !oDuration || *oDuration <= 0 || !oTime
+        || *oTime < 0 || (pAdvance && !pAdvance->is_string()) || (pAll && !pAll->is_bool()))
+        return false;
+    const OUString aId = lcl_String(*pPreset);
+    TransitionPresetPtr pFound;
+    for (const TransitionPresetPtr& pOne : TransitionPreset::getTransitionPresetList())
+        if (pOne->getPresetId() == aId)
+            pFound = pOne;
+    const OUString aAdvance = pAdvance ? lcl_String(*pAdvance) : u"click"_ustr;
+    if ((!aId.isEmpty() && !pFound) || (aAdvance != "click" && aAdvance != "auto"))
+        return false;
+    std::vector<SdPage*> aPages;
+    if (pAll && pAll->as_bool())
+        for (sal_uInt16 n = 0; n < GetDoc()->GetSdPageCount(PageKind::Standard); ++n)
+            aPages.push_back(GetDoc()->GetSdPage(n, PageKind::Standard));
+    else if (getCurrentPage() && !getCurrentPage()->IsMasterPage())
+        aPages.push_back(getCurrentPage());
+    if (aPages.empty())
+        return false;
+    SfxUndoManager* pManager = GetDocSh()->GetUndoManager();
+    const OUString aComment(SdResId(STR_UNDO_SLIDE_PARAMS));
+    pManager->EnterListAction(aComment, aComment, 0, GetViewShellBase().GetViewShellId());
+    std::unique_ptr<SdUndoGroup> pGroup(new SdUndoGroup(*GetDoc()));
+    pGroup->SetComment(aComment);
+    for (SdPage* pPage : aPages)
+    {
+        pGroup->AddAction(new UndoTransition(*GetDoc(), pPage));
+        pPage->setTransitionType(pFound ? pFound->getTransition() : 0);
+        pPage->setTransitionSubtype(pFound ? pFound->getSubtype() : 0);
+        pPage->setTransitionDirection(pFound ? pFound->getDirection() : true);
+        pPage->setTransitionFadeColor(pFound ? pFound->getFadeColor() : 0);
+        pPage->setTransitionDuration(*oDuration);
+        pPage->SetPresChange(aAdvance == "auto" ? PresChange::Auto : PresChange::Manual);
+        pPage->SetTime(*oTime);
+    }
+    pManager->AddUndoAction(std::move(pGroup));
+    pManager->LeaveListAction();
+    GetDocSh()->SetModified();
+    return true;
+}
+
+bool DrawViewShell::KitAddAnimation(std::u16string_view rJson)
+{
+    const std::optional<boost::json::object> oObject = lcl_Object(rJson);
+    const boost::json::value* pPreset = oObject ? oObject->if_contains("preset") : nullptr;
+    if (!pPreset || !pPreset->is_string())
+        return false;
+    const CustomAnimationPresetPtr pDescriptor
+        = CustomAnimationPresets::getCustomAnimationPresets().getEffectDescriptor(lcl_String(*pPreset));
+    const std::optional<double> oDuration
+        = pDescriptor ? lcl_Number(*oObject, "duration", pDescriptor->getDuration()) : std::nullopt;
+    const SdrMarkList& rMarks = mpDrawView->GetMarkedObjectList();
+    SdPage* pPage = getCurrentPage();
+    if (!oDuration || *oDuration <= 0 || rMarks.GetMarkCount() == 0 || !pPage)
+        return false;
+    const MainSequencePtr& pSequence = pPage->getMainSequence();
+    pSequence->getRootNode();
+    GetDocSh()->GetUndoManager()->AddUndoAction(std::make_unique<UndoAnimation>(GetDoc(), pPage));
+    for (size_t n = 0; n < rMarks.GetMarkCount(); ++n)
+    {
+        uno::Any aTarget(rMarks.GetMark(n)->GetMarkedSdrObj()->getUnoShape());
+        CustomAnimationEffectPtr pEffect = pSequence->append(pDescriptor, aTarget, *oDuration);
+        // Several objects at once go together.
+        if (n > 0)
+            pEffect->setNodeType(EffectNodeType::WITH_PREVIOUS);
+    }
+    pSequence->getRootNode();
+    GetDocSh()->SetModified();
+    return true;
+}
+
+bool DrawViewShell::KitChangeAnimation(std::u16string_view rJson)
+{
+    const std::optional<boost::json::object> oObject = lcl_Object(rJson);
+    SdPage* pPage = getCurrentPage();
+    if (!oObject || !pPage)
+        return false;
+    const std::vector<CustomAnimationEffectPtr> aEffects = lcl_Effects(*pPage);
+    const boost::json::value* pIndex = oObject->if_contains("index");
+    if (!pIndex || !pIndex->is_int64() || pIndex->as_int64() < 0
+        || pIndex->as_int64() >= sal_Int64(aEffects.size()))
+        return false;
+    const CustomAnimationEffectPtr& pEffect = aEffects[pIndex->as_int64()];
+    const boost::json::value* pStart = oObject->if_contains("start");
+    const boost::json::value* pMove = oObject->if_contains("move");
+    const boost::json::value* pRemove = oObject->if_contains("remove");
+    const std::optional<double> oDuration = lcl_Number(*oObject, "duration", pEffect->getDuration());
+    const std::optional<double> oDelay = lcl_Number(*oObject, "delay", pEffect->getBegin());
+    std::optional<sal_Int16> oNode;
+    for (const auto& [nType, rName] : aStarts)
+        if (pStart && pStart->is_string() && rName == lcl_String(*pStart))
+            oNode = nType;
+    const sal_Int64 nTo = pMove && pMove->is_int64() ? pIndex->as_int64() + pMove->as_int64() : 0;
+    if ((pStart && !oNode) || !oDuration || *oDuration <= 0 || !oDelay || *oDelay < 0
+        || (pMove && (!pMove->is_int64() || nTo < 0 || nTo >= sal_Int64(aEffects.size())))
+        || (pRemove && !pRemove->is_bool()))
+        return false;
+    const MainSequencePtr& pSequence = pPage->getMainSequence();
+    pSequence->getRootNode();
+    GetDocSh()->GetUndoManager()->AddUndoAction(std::make_unique<UndoAnimation>(GetDoc(), pPage));
+    if (pRemove && pRemove->as_bool())
+        pSequence->remove(pEffect);
+    else
+    {
+        if (oNode)
+            pEffect->setNodeType(*oNode);
+        pEffect->setDuration(*oDuration);
+        pEffect->setBegin(*oDelay);
+        if (pMove)
+        {
+            EffectSequence& rList = pSequence->getSequence();
+            rList.erase(pSequence->find(pEffect));
+            rList.insert(std::next(rList.begin(), nTo), pEffect);
+        }
+        pSequence->rebuild();
+    }
+    pSequence->getRootNode();
+    GetDocSh()->SetModified();
+    return true;
+}
+
+void DrawViewShell::WriteKitTransition(::tools::JsonWriter& rJson, SdPage& rPage)
+{
+    OUString aId;
+    for (const TransitionPresetPtr& pOne : TransitionPreset::getTransitionPresetList())
+        if (rPage.getTransitionType() && pOne->getTransition() == rPage.getTransitionType()
+            && pOne->getSubtype() == rPage.getTransitionSubtype()
+            && pOne->getDirection() == rPage.getTransitionDirection()
+            && pOne->getFadeColor() == rPage.getTransitionFadeColor() && aId.isEmpty())
+            aId = pOne->getPresetId();
+    // A transition no preset matches.
+    if (rPage.getTransitionType() && aId.isEmpty())
+        aId = "other";
+    rJson.put("preset", aId);
+    rJson.put("duration", rPage.getTransitionDuration());
+    rJson.put("advance", rPage.GetPresChange() == PresChange::Manual ? "click" : "auto");
+    rJson.put("time", rPage.GetTime());
+}
+
+void DrawViewShell::WriteKitAnimations(::tools::JsonWriter& rJson, SdPage& rPage)
+{
+    const std::vector<SdrObject*> aShapes = lcl_Shapes(rPage);
+    const CustomAnimationPresets& rPresets = CustomAnimationPresets::getCustomAnimationPresets();
+    auto aList = rJson.startArray("effects");
+    for (const CustomAnimationEffectPtr& pEffect : lcl_Effects(rPage))
+    {
+        auto aOne = rJson.startStruct();
+        rJson.put("preset", pEffect->getPresetId());
+        const CustomAnimationPresetPtr pDescriptor = rPresets.getEffectDescriptor(pEffect->getPresetId());
+        rJson.put("label", pDescriptor ? pDescriptor->getLabel() : OUString());
+        std::string_view aClass = "other";
+        for (const auto& [nClass, rName] : aClasses)
+            if (nClass == pEffect->getPresetClass())
+                aClass = rName;
+        rJson.put("class", aClass);
+        SdrObject* pTarget = SdrObject::getSdrObjectFromXShape(pEffect->getTargetShape());
+        const auto pAt = std::find(aShapes.begin(), aShapes.end(), pTarget);
+        rJson.put("target", pAt == aShapes.end() ? sal_Int64(-1) : sal_Int64(pAt - aShapes.begin()));
+        // The slideshow layer of the same shape has this hash.
+        OStringBuffer aHash;
+        anim::convertTarget(aHash, pEffect->getTarget());
+        rJson.put("hash", aHash.makeStringAndClear());
+        std::u16string_view aStart = u"click";
+        for (const auto& [nType, rName] : aStarts)
+            if (nType == pEffect->getNodeType())
+                aStart = rName;
+        rJson.put("start", OUString(aStart));
+        rJson.put("duration", pEffect->getDuration());
+        rJson.put("delay", pEffect->getBegin());
+    }
+}
+}
+
