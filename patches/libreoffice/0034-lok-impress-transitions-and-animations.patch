+std::optional<boost::json::object> lcl_Object(std::u16string_view rJson)
+{
+    boost::system::error_code aError;
+    boost::json::value aValue = boost::json::parse(std::string(OUString(rJson).toUtf8()), aError);
+    if (aError || !aValue.is_object())
+        return std::nullopt;
+    return aValue.as_object();
+}
+
+OUString lcl_String(const boost::json::value& rValue)
+{
+    return OUString::fromUtf8(std::string_view(rValue.as_string().data(), rValue.as_string().size()));
+}
+
+/// Member `rKey` as a number; absent is `fDefault`; else fails.
+std::optional<double> lcl_Number(const boost::json::object& rObject, std::string_view rKey,
+                                 double fDefault)
+{
+    const boost::json::value* pValue = rObject.if_contains(rKey);
+    if (!pValue)
+        return fDefault;
+    if (!pValue->is_number())
+        return std::nullopt;
+    return pValue->to_number<double>();
+}
+
+/// The slide's objects, comments left out, as .uno:SlideObjects lists them.
+std::vector<SdrObject*> lcl_Shapes(SdPage& rPage)
+{
+    std::vector<SdrObject*> aShapes;
+    for (const rtl::Reference<SdrObject>& pObj : rPage)
+        if (!pObj->isAnnotationObject())
+            aShapes.push_back(pObj.get());
+    return aShapes;
+}
+
+/// Start kinds as the kit names them.
+constexpr std::pair<sal_Int16, std::u16string_view> aStarts[]
+    = { { EffectNodeType::ON_CLICK, u"click" },
+        { EffectNodeType::WITH_PREVIOUS, u"with" },
+        { EffectNodeType::AFTER_PREVIOUS, u"after" } };
+
+/// Preset classes as the kit names them; others are "other".
+constexpr std::pair<sal_Int16, std::string_view> aClasses[]
+    = { { EffectPresetClass::ENTRANCE, "entrance" },
+        { EffectPresetClass::EMPHASIS, "emphasis" },
+        { EffectPresetClass::EXIT, "exit" } };
+
+/// The main sequence's effects, in order.
+std::vector<sd::CustomAnimationEffectPtr> lcl_Effects(SdPage& rPage)
+{
+    const sd::MainSequencePtr& pSequence = rPage.getMainSequence();
+    return std::vector<sd::CustomAnimationEffectPtr>(pSequence->getBegin(), pSequence->getEnd());
+}
+}
