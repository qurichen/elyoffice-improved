Writer: import and export East Asian character compression

DOCX characterSpacingControl was ignored on import and absent on export.
Map the three valid modes onto the existing CharacterCompressionType
setting, and serialize the actual model setting back into DOCX.
An absent setting leaves the existing document default alone, including
RTF imports. Do not replace layout data with original document XML.

The regression covers none, punctuation, punctuation plus Japanese kana,
and the omitted default. It reads flat-ODF model settings before and
after DOCX, so retaining only an XML token cannot hide a broken import.
A rebuilt C++ engine still needs to run the new regression test.

diff --git a/sw/source/filter/ww8/docxexport.cxx b/sw/source/filter/ww8/docxexport.cxx
index d06f58e..9e62ff4 100644
--- a/sw/source/filter/ww8/docxexport.cxx
+++ b/sw/source/filter/ww8/docxexport.cxx
@@ -100,6 +100,7 @@
 #include <comphelper/sequenceashashmap.hxx>
 #include <o3tl/any.hxx>
 #include <sal/log.hxx>
+#include <svl/asiancfg.hxx>
 #include <unotools/ucbstreamhelper.hxx>
 #include <comphelper/diagnose_ex.hxx>
 #include <unotxdoc.hxx>
@@ -1455,6 +1456,24 @@ void DocxExport::WriteSettings()
     if( m_aSettings.evenAndOddHeaders )
         pFS->singleElementNS(XML_w, XML_evenAndOddHeaders);
 
+    const char* pCharacterSpacing;
+    switch (m_rDoc.getIDocumentSettingAccess().getCharacterCompressionType())
+    {
+        case CharCompressType::NONE:
+            pCharacterSpacing = "doNotCompress";
+            break;
+        case CharCompressType::PunctuationOnly:
+            pCharacterSpacing = "compressPunctuation";
+            break;
+        case CharCompressType::PunctuationAndKana:
+            pCharacterSpacing = "compressPunctuationAndJapaneseKana";
+            break;
+        default:
+            throw uno::RuntimeException(u"Invalid character compression mode"_ustr);
+    }
+    pFS->singleElementNS(XML_w, XML_characterSpacingControl,
+                         FSNS(XML_w, XML_val), pCharacterSpacing);
+
     // Has Footnotes
     if( m_pAttrOutput->HasFootnotes())
         m_pAttrOutput->WriteFootnoteEndnotePr( pFS, XML_footnotePr, m_rDoc.GetFootnoteInfo(), XML_footnote );
