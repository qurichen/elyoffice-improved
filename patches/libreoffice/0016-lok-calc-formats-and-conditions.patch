+/// A "#RRGGBB" text as a color.
+Color lcl_Color(const std::string& rText)
+{
+    return Color(ColorTransparency, OUString::fromUtf8(rText).copy(1).toUInt32(16));
+}
+
+/// Adds or removes the conditional format a kit client describes.
+bool lcl_ConditionalFormat(ScViewData& rData, const OUString& rRule)
+{
+    boost::property_tree::ptree aRule;
+    std::stringstream aStream{ std::string(rRule.toUtf8()) };
+    try
+    {
+        boost::property_tree::read_json(aStream, aRule);
+    }
+    catch (const boost::property_tree::json_parser_error&)
+    {
+        return false;
+    }
+    ScDocument& rDoc = rData.GetDocument();
+    ScDocFunc& rFunc = rData.GetDocShell()->GetDocFunc();
+    const SCTAB nTab = rData.CurrentTabForData();
+    if (const auto oKey = aRule.get_optional<sal_uInt32>("remove"))
+    {
+        ScConditionalFormatList* pList = rDoc.GetCondFormList(nTab);
+        ScConditionalFormat* pOld = pList ? pList->GetFormat(*oKey) : nullptr;
+        if (!pOld)
+            return false;
+        const ScRangeList aOldRange = pOld->GetRange();
+        rFunc.ReplaceConditionalFormat(*oKey, nullptr, nTab, aOldRange);
+        return true;
+    }
+    ScRangeList aRanges;
+    ScMarkData aMark(rData.GetMarkData());
+    aMark.MarkToMulti();
+    aMark.FillRangeListWithMarks(&aRanges, false, nTab);
+    if (aRanges.empty())
+        aRanges.push_back(ScRange(rData.GetCurX(), rData.GetCurY(), nTab));
+    const ScAddress aPos = aRanges.GetTopLeftCorner();
+    auto pFormat = std::make_unique<ScConditionalFormat>(0, rDoc);
+    const std::string aKind = aRule.get<std::string>("kind", "");
+    if (aKind == "cell")
+    {
+        static const std::pair<std::string_view, ScConditionMode> aModes[]
+            = { { "equal", ScConditionMode::Equal },
+                { "notequal", ScConditionMode::NotEqual },
+                { "less", ScConditionMode::Less },
+                { "lessequal", ScConditionMode::EqLess },
+                { "greater", ScConditionMode::Greater },
+                { "greaterequal", ScConditionMode::EqGreater },
+                { "between", ScConditionMode::Between },
+                { "notbetween", ScConditionMode::NotBetween },
+                { "duplicate", ScConditionMode::Duplicate },
+                { "unique", ScConditionMode::NotDuplicate },
+                { "top10", ScConditionMode::Top10 },
+                { "bottom10", ScConditionMode::Bottom10 },
+                { "aboveaverage", ScConditionMode::AboveAverage },
+                { "belowaverage", ScConditionMode::BelowAverage },
+                { "error", ScConditionMode::Error },
+                { "contains", ScConditionMode::ContainsText },
+                { "beginswith", ScConditionMode::BeginsWith },
+                { "endswith", ScConditionMode::EndsWith } };
+        const std::string aOp = aRule.get<std::string>("operator", "");
+        const auto pMode = std::find_if(std::begin(aModes), std::end(aModes),
+                                        [&aOp](const auto& rPair) { return rPair.first == aOp; });
+        const OUString aStyle = OUString::fromUtf8(aRule.get<std::string>("style", ""));
+        if (pMode == std::end(aModes) || !rDoc.GetStyleSheetPool()->Find(aStyle, SfxStyleFamily::Para))
+            return false;
+        OUString aExpr1 = OUString::fromUtf8(aRule.get<std::string>("value1", ""));
+        OUString aExpr2 = OUString::fromUtf8(aRule.get<std::string>("value2", ""));
+        // Text conditions compare strings, as the dialog does.
+        if (pMode->second == ScConditionMode::ContainsText || pMode->second == ScConditionMode::BeginsWith
+            || pMode->second == ScConditionMode::EndsWith)
+            aExpr1 = "\"" + aExpr1.replaceAll("\"", "\"\"") + "\"";
+        pFormat->AddEntry(new ScCondFormatEntry(pMode->second, aExpr1, aExpr2, rDoc, aPos, aStyle));
+    }
+    else if (aKind == "scale")
+    {
+        std::vector<Color> aColors;
+        if (const auto oColors = aRule.get_child_optional("colors"))
+            for (const auto& rColor : *oColors)
+                aColors.push_back(lcl_Color(rColor.second.data()));
+        if (aColors.size() != 2 && aColors.size() != 3)
+            return false;
+        auto* pScale = new ScColorScaleFormat(rDoc);
+        pScale->AddEntry(new ScColorScaleEntry(0, aColors.front(), COLORSCALE_MIN));
+        if (aColors.size() == 3)
+            pScale->AddEntry(new ScColorScaleEntry(50, aColors[1], COLORSCALE_PERCENTILE));
+        pScale->AddEntry(new ScColorScaleEntry(0, aColors.back(), COLORSCALE_MAX));
+        pFormat->AddEntry(pScale);
+    }
+    else if (aKind == "databar")
+    {
+        auto* pBar = new ScDataBarFormat(rDoc);
+        auto* pData = new ScDataBarFormatData();
+        pData->maPositiveColor = lcl_Color(aRule.get<std::string>("color", "#638EC6"));
+        pData->mpLowerLimit.reset(new ScColorScaleEntry(0, COL_BLACK, COLORSCALE_AUTO));
+        pData->mpUpperLimit.reset(new ScColorScaleEntry(0, COL_BLACK, COLORSCALE_AUTO));
+        pBar->SetDataBarData(pData);
+        pFormat->AddEntry(pBar);
+    }
+    else
+        return false;
+    pFormat->SetRange(aRanges);
+    rFunc.ReplaceConditionalFormat(0, std::move(pFormat), nTab, aRanges);
+    return true;
+}
+}
