+
+bool SmIsWordEq(const uno::Reference<beans::XPropertySet>& xProperties)
+{
+    uno::Sequence<beans::PropertyValue> aBag;
+    xProperties->getPropertyValue(u"InteropGrabBag"_ustr) >>= aBag;
+    for (const auto& rProperty : aBag)
+    {
+        bool bWordEq = false;
+        if (rProperty.Name == "WordEQ" && (rProperty.Value >>= bWordEq))
+            return bWordEq;
+    }
+    return false;
+}
+
+void SmMarkWordEq(const uno::Reference<beans::XPropertySet>& xProperties)
+{
+    uno::Sequence<beans::PropertyValue> aBag;
+    xProperties->getPropertyValue(u"InteropGrabBag"_ustr) >>= aBag;
+    for (sal_Int32 i = 0; i < aBag.getLength(); ++i)
+    {
+        if (aBag[i].Name == "WordEQ")
+        {
+            aBag.getArray()[i].Value <<= true;
+            xProperties->setPropertyValue(u"InteropGrabBag"_ustr, uno::Any(aBag));
+            return;
+        }
+    }
+    const sal_Int32 nSize = aBag.getLength();
+    aBag.realloc(nSize + 1);
+    aBag.getArray()[nSize] = comphelper::makePropertyValue(u"WordEQ"_ustr, true);
+    xProperties->setPropertyValue(u"InteropGrabBag"_ustr, uno::Any(aBag));
+}
+
+namespace
+{
+class EqExport
+{
+    const SmFace* m_pFont = nullptr;
+
+    bool text(const SmTextNode* pNode, OUStringBuffer& rCode, OUStringBuffer& rDisplay)
+    {
+        if (pNode->GetToken().eType != TTEXT)
+            return false;
+        const SmFace& rFont = pNode->GetFont();
+        if (rFont.GetWeight() != WEIGHT_NORMAL && rFont.GetWeight() != WEIGHT_BOLD)
+            return false;
+        if (rFont.GetItalic() != ITALIC_NONE && rFont.GetItalic() != ITALIC_NORMAL)
+            return false;
+        if (rFont.GetColor() != COL_AUTO && rFont.GetColor() != COL_BLACK)
+            return false;
+        if (m_pFont && (rFont.GetFamilyName() != m_pFont->GetFamilyName()
+                        || rFont.GetFontSize().Height() != m_pFont->GetFontSize().Height()
+                        || rFont.GetWeight() != m_pFont->GetWeight()
+                        || rFont.GetItalic() != m_pFont->GetItalic()))
+            return false;
+        m_pFont = &rFont;
+        const OUString& rText = pNode->GetText();
+        for (sal_Int32 i = 0; i < rText.getLength(); ++i)
+        {
+            const sal_Unicode c = rText[i];
+            if (c < 0x20 || c > 0x7e || c == '"')
+                return false;
+            if (c == '\\' || c == ',' || c == '(' || c == ')')
+                rCode.append('\\');
+            rCode.append(c);
+            rDisplay.append(c);
+        }
+        return true;
+    }
+
+    bool node(const SmNode* pNode, OUStringBuffer& rCode, OUStringBuffer& rDisplay)
+    {
+        if (!pNode)
+            return false;
+        switch (pNode->GetType())
+        {
+            case SmNodeType::Text:
+                return text(static_cast<const SmTextNode*>(pNode), rCode, rDisplay);
+            case SmNodeType::BinVer:
+                if (pNode->GetToken().eType != TOVER || pNode->GetNumSubNodes() != 3)
+                    return false;
+                rCode.append("\\f(");
+                rDisplay.append('(');
+                if (!node(pNode->GetSubNode(0), rCode, rDisplay))
+                    return false;
+                rCode.append(',');
+                rDisplay.append(")/(");
+                if (!node(pNode->GetSubNode(2), rCode, rDisplay))
+                    return false;
+                rCode.append(')');
+                rDisplay.append(')');
+                return true;
+            case SmNodeType::Font:
+                if (pNode->GetToken().eType != TSIZE)
+                    return false;
+                return node(pNode->GetSubNode(1), rCode, rDisplay);
+            case SmNodeType::Table:
+                if (pNode->GetNumSubNodes() != 1)
+                    return false;
+                [[fallthrough]];
+            case SmNodeType::Line:
+            case SmNodeType::Expression:
+            {
+                size_t nContent = 0;
+                for (size_t i = 0; i < pNode->GetNumSubNodes(); ++i)
+                {
+                    const SmNode* pChild = pNode->GetSubNode(i);
+                    const bool bSpace = pChild && pChild->GetType() == SmNodeType::Text
+                        && static_cast<const SmTextNode*>(pChild)->GetText().trim().isEmpty();
+                    if (!bSpace && ++nContent > 1)
+                        return false;
+                    if (!node(pNode->GetSubNode(i), rCode, rDisplay))
+                        return false;
+                }
+                return true;
+            }
+            default:
+                return false;
+        }
+    }
+
+    void properties(const sax_fastparser::FSHelperPtr& pSerializer)
+    {
+        pSerializer->startElementNS(XML_w, XML_rPr);
+        pSerializer->singleElementNS(XML_w, XML_rFonts,
+            FSNS(XML_w, XML_ascii), m_pFont->GetFamilyName(),
+            FSNS(XML_w, XML_hAnsi), m_pFont->GetFamilyName());
+        pSerializer->singleElementNS(XML_w, XML_b, FSNS(XML_w, XML_val),
+            m_pFont->GetWeight() == WEIGHT_BOLD ? "1" : "0");
+        pSerializer->singleElementNS(XML_w, XML_i, FSNS(XML_w, XML_val),
+            m_pFont->GetItalic() == ITALIC_NORMAL ? "1" : "0");
+        pSerializer->singleElementNS(XML_w, XML_color, FSNS(XML_w, XML_val),
+            m_pFont->GetColor() == COL_AUTO ? "auto" : "000000");
+        const auto nHalfPoints = o3tl::convert(m_pFont->GetFontSize().Height() * 2,
+            SmO3tlLengthUnit(), o3tl::Length::pt);
+        pSerializer->singleElementNS(XML_w, XML_sz, FSNS(XML_w, XML_val), OString::number(nHalfPoints));
+        pSerializer->endElementNS(XML_w, XML_rPr);
+    }
+
+public:
+    bool write(const SmNode* pTree, const sax_fastparser::FSHelperPtr& pSerializer)
+    {
+        OUStringBuffer aCode;
+        OUStringBuffer aDisplay;
+        if (!node(pTree, aCode, aDisplay) || !m_pFont || aCode.isEmpty()
+            || aCode[0] == ' ')
+            return false;
+        pSerializer->startElementNS(XML_w, XML_r);
+        properties(pSerializer);
+        pSerializer->singleElementNS(XML_w, XML_fldChar, FSNS(XML_w, XML_fldCharType), "begin");
+        pSerializer->endElementNS(XML_w, XML_r);
+        pSerializer->startElementNS(XML_w, XML_r);
+        properties(pSerializer);
+        pSerializer->startElementNS(XML_w, XML_instrText, FSNS(XML_xml, XML_space), "preserve");
+        const OUString aInstruction = u" EQ "_ustr + aCode.makeStringAndClear();
+        pSerializer->writeEscaped(aInstruction);
+        pSerializer->endElementNS(XML_w, XML_instrText);
+        pSerializer->endElementNS(XML_w, XML_r);
+        pSerializer->startElementNS(XML_w, XML_r);
+        properties(pSerializer);
+        pSerializer->singleElementNS(XML_w, XML_fldChar, FSNS(XML_w, XML_fldCharType), "separate");
+        pSerializer->endElementNS(XML_w, XML_r);
+        pSerializer->startElementNS(XML_w, XML_r);
+        properties(pSerializer);
+        pSerializer->startElementNS(XML_w, XML_t, FSNS(XML_xml, XML_space), "preserve");
+        pSerializer->writeEscaped(aDisplay.makeStringAndClear());
+        pSerializer->endElementNS(XML_w, XML_t);
+        pSerializer->endElementNS(XML_w, XML_r);
+        pSerializer->startElementNS(XML_w, XML_r);
+        properties(pSerializer);
+        pSerializer->singleElementNS(XML_w, XML_fldChar, FSNS(XML_w, XML_fldCharType), "end");
+        pSerializer->endElementNS(XML_w, XML_r);
+        return true;
+    }
+};
+}
+
+bool SmExportWordEq(const SmNode* pTree, const sax_fastparser::FSHelperPtr& pSerializer)
+{
+    return EqExport().write(pTree, pSerializer);
+}
