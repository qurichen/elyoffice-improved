+/// Makes or changes the pivot table a kit client describes.
+bool lcl_KitPivot(ScTabViewShell& rShell, ScViewData& rData, const OUString& rJson)
+{
+    boost::property_tree::ptree aTree;
+    std::stringstream aStream{ std::string(rJson.toUtf8()) };
+    try
+    {
+        boost::property_tree::read_json(aStream, aTree);
+    }
+    catch (const boost::property_tree::json_parser_error&)
+    {
+        return false;
+    }
+    ScDocument& rDoc = rData.GetDocument();
+    const ScAddress aCursor(rData.GetCurX(), rData.GetCurY(), rData.CurrentTabForData());
+    // On a pivot table: change it; else make one.
+    std::unique_ptr<ScDPObject> pObj;
+    if (const ScDPObject* pOld = rDoc.GetDPAtCursor(aCursor))
+        pObj = std::make_unique<ScDPObject>(*pOld);
+    else
+    {
+        ScRange aSource;
+        const ScAddress::Details aDetails(rDoc.GetAddressConvention(), 0, 0);
+        const OUString aText = OUString::fromUtf8(aTree.get<std::string>("source", ""));
+        if (!(aSource.ParseAny(aText, rDoc, aDetails) & ScRefFlags::VALID))
+            return false;
+        ScSheetSourceDesc aDesc(&rDoc);
+        aDesc.SetSourceRange(aSource);
+        if (aDesc.CheckSourceRange())
+            return false;
+        pObj = std::make_unique<ScDPObject>(&rDoc);
+        pObj->SetSheetDesc(aDesc);
+        pObj->SetOutRange(ScRange(aCursor));
+    }
+    ScPivotParam aParam;
+    pObj->FillOldParam(aParam);
+    pObj->FillLabelData(aParam);
+    // The named fields, as the layout dialog lists them.
+    auto aFields = [&aTree, &aParam](const char* pKey, bool bData, ScPivotFieldVector& rOut)
+    {
+        static const boost::property_tree::ptree aNone;
+        for (const auto& [rKey, rEntry] : aTree.get_child(pKey, aNone))
+        {
+            const OUString aName = OUString::fromUtf8(
+                bData ? rEntry.get<std::string>("field", "") : rEntry.get_value<std::string>());
+            // An empty name places the data layout field.
+            if (!bData && aName.isEmpty())
+            {
+                rOut.push_back(ScPivotField(PIVOT_DATA_FIELD));
+                continue;
+            }
+            const auto pLabel = std::find_if(
+                aParam.maLabelArray.begin(), aParam.maLabelArray.end(),
+                [&aName](const auto& rLabel) { return !rLabel->mbDataLayout && rLabel->maName == aName; });
+            if (pLabel == aParam.maLabelArray.end())
+                return false;
+            ScPivotField aField((*pLabel)->mnCol);
+            if (bData)
+            {
+                const std::string aFunc = rEntry.get<std::string>("function", "");
+                const auto pFunc = std::find_if(std::begin(aKitPivotFuncs), std::end(aKitPivotFuncs),
+                                                [&aFunc](const auto& rPair) { return rPair.first == aFunc; });
+                if (pFunc == std::end(aKitPivotFuncs))
+                    return false;
+                aField.nFuncMask = pFunc->second;
+            }
+            else
+            {
+                // A field already placed keeps its subtotals.
+                for (const ScPivotFieldVector* pPlaced : { &aParam.maRowFields, &aParam.maColFields, &aParam.maPageFields })
+                    for (const ScPivotField& rPlaced : *pPlaced)
+                        if (rPlaced.nCol == aField.nCol)
+                            aField.nFuncMask = rPlaced.nFuncMask;
+            }
+            rOut.push_back(aField);
+        }
+        return true;
+    };
+    ScPivotFieldVector aPages, aColumns, aRows, aData;
+    if (!aFields("pages", false, aPages) || !aFields("columns", false, aColumns)
+        || !aFields("rows", false, aRows) || !aFields("data", true, aData) || aData.empty())
+        return false;
+    // Options as the dialog starts them.
+    ScDPSaveData aSave;
+    const ScDPSaveData* pOldSave = pObj->GetSaveData();
+    aSave.SetFilterButton(pOldSave && pOldSave->GetFilterButton());
+    aSave.SetDrillDown(pOldSave && pOldSave->GetDrillDown());
+    aSave.SetExpandCollapse(pOldSave && pOldSave->GetExpandCollapse());
+    aSave.SetIgnoreEmptyRows(aParam.bIgnoreEmptyRows);
+    aSave.SetRepeatIfEmpty(aParam.bDetectCategories);
+    aSave.SetColumnGrand(aParam.bMakeTotalCol);
+    aSave.SetRowGrand(aParam.bMakeTotalRow);
+    const auto xSource = pObj->GetSource();
+    using css::sheet::DataPilotFieldOrientation_PAGE, css::sheet::DataPilotFieldOrientation_COLUMN,
+        css::sheet::DataPilotFieldOrientation_ROW, css::sheet::DataPilotFieldOrientation_DATA;
+    ScDPObject::ConvertOrientation(aSave, aPages, DataPilotFieldOrientation_PAGE, xSource, aParam.maLabelArray);
+    ScDPObject::ConvertOrientation(aSave, aColumns, DataPilotFieldOrientation_COLUMN, xSource, aParam.maLabelArray);
+    ScDPObject::ConvertOrientation(aSave, aRows, DataPilotFieldOrientation_ROW, xSource, aParam.maLabelArray);
+    ScDPObject::ConvertOrientation(aSave, aData, DataPilotFieldOrientation_DATA, xSource, aParam.maLabelArray,
+                                   &aColumns, &aRows, &aPages);
+    // Keep members, sort and layout, as the dialog does.
+    for (const auto& pLabel : aParam.maLabelArray)
+    {
+        ScDPSaveDimension* pDim = aSave.GetExistingDimensionByName(
+            ScDPUtil::createDuplicateDimensionName(pLabel->maName, pLabel->mnDupCount));
+        if (!pDim)
+            continue;
+        pDim->SetUsedHierarchy(pLabel->mnUsedHier);
+        pDim->SetShowEmpty(pLabel->mbShowAll);
+        pDim->SetRepeatItemLabels(pLabel->mbRepeatItemLabels);
+        pDim->SetSortInfo(&pLabel->maSortInfo);
+        pDim->SetLayoutInfo(&pLabel->maLayoutInfo);
+        pDim->SetAutoShowInfo(&pLabel->maShowInfo);
+        const bool bManualSort = pLabel->maSortInfo.Mode == css::sheet::DataPilotFieldSortMode::MANUAL;
+        for (const ScDPLabelData::Member& rMember : pLabel->maMembers)
+        {
+            if (!bManualSort && rMember.mbVisible && rMember.mbShowDetails)
+                continue;
+            ScDPSaveMember* pMember = pDim->GetMemberByName(rMember.maName);
+            pMember->SetIsVisible(rMember.mbVisible);
+            pMember->SetShowDetails(rMember.mbShowDetails);
+        }
+    }
+    // "dest": a cell; empty for a new sheet.
+    const OUString aDest = OUString::fromUtf8(aTree.get<std::string>("dest", ""));
+    ScRange aDestRange(pObj->GetOutRange().aStart);
+    const bool bEdit = rDoc.GetDPAtCursor(aCursor) != nullptr;
+    if (!bEdit && !aDest.isEmpty())
+    {
+        ScAddress aAt;
+        const ScAddress::Details aDetails(rDoc.GetAddressConvention(), 0, 0);
+        if (!(aAt.Parse(aDest, rDoc, aDetails) & ScRefFlags::VALID))
+            return false;
+        aDestRange = ScRange(aAt);
+    }
+    return rShell.MakePivotTable(aSave, aDestRange, !bEdit && aDest.isEmpty(), *pObj);
+}
+}
