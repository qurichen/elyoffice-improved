+/// The pivot table at the cursor: ranges and fields.
+void lcl_PivotTable(tools::JsonWriter& rJson, ScDocument& rDoc, const ScAddress& rCursor)
+{
+    rJson.put("commandName", ".uno:PivotTable");
+    const ScDPObject* pFound = rDoc.GetDPAtCursor(rCursor);
+    if (!pFound)
+        return;
+    ScDPObject aObj(*pFound);
+    ScPivotParam aParam;
+    aObj.FillOldParam(aParam);
+    aObj.FillLabelData(aParam);
+    const ScAddress::Details aDetails(rDoc.GetAddressConvention(), 0, 0);
+    rJson.put("name", aObj.GetName());
+    rJson.put("range", aObj.GetOutRange().Format(rDoc, ScRefFlags::RANGE_ABS_3D, aDetails));
+    const ScSheetSourceDesc* pDesc = aObj.GetSheetDesc();
+    rJson.put("source", pDesc ? pDesc->GetSourceRange().Format(rDoc, ScRefFlags::RANGE_ABS_3D, aDetails)
+                              : OUString());
+    auto aNameOf = [&aParam](const ScPivotField& rField)
+    {
+        for (const auto& pLabel : aParam.maLabelArray)
+            if (pLabel->mnCol == rField.getOriginalDim())
+                return pLabel->maName;
+        return OUString();
+    };
+    {
+        auto aFields = rJson.startArray("fields");
+        for (const auto& pLabel : aParam.maLabelArray)
+            if (!pLabel->mbDataLayout && pLabel->mnOriginalDim < 0)
+                rJson.putSimpleValue(pLabel->maName);
+    }
+    for (const auto& [pKey, pFields] : { std::pair("rows", &aParam.maRowFields),
+                                        std::pair("columns", &aParam.maColFields),
+                                        std::pair("pages", &aParam.maPageFields) })
+    {
+        auto aNames = rJson.startArray(pKey);
+        // The data layout field reads as an empty name.
+        for (const ScPivotField& rField : *pFields)
+            rJson.putSimpleValue(rField.nCol == PIVOT_DATA_FIELD ? OUString() : aNameOf(rField));
+    }
+    auto aData = rJson.startArray("data");
+    for (const ScPivotField& rField : aParam.maDataFields)
+    {
+        auto aField = rJson.startStruct();
+        rJson.put("field", aNameOf(rField));
+        const auto pFunc = std::find_if(std::begin(aKitPivotFuncs), std::end(aKitPivotFuncs),
+                                        [&rField](const auto& rPair) { return rPair.second == rField.nFuncMask; });
+        rJson.put("function", pFunc != std::end(aKitPivotFuncs) ? pFunc->first : std::string_view("other"));
+    }
+}
