+/// Sets the validation a kit client describes on the selection.
+bool lcl_SetValidation(ScTabViewShell& rView, ScViewData& rData,
+                       const boost::property_tree::ptree& rRule)
+{
+    static const std::pair<std::string_view, ScValidationMode> aModes[]
+        = { { "any", SC_VALID_ANY },          { "whole", SC_VALID_WHOLE },
+            { "decimal", SC_VALID_DECIMAL },  { "date", SC_VALID_DATE },
+            { "time", SC_VALID_TIME },        { "textlength", SC_VALID_TEXTLEN },
+            { "list", SC_VALID_LIST },        { "custom", SC_VALID_CUSTOM } };
+    static const std::pair<std::string_view, ScConditionMode> aOperators[]
+        = { { "equal", ScConditionMode::Equal },
+            { "notequal", ScConditionMode::NotEqual },
+            { "less", ScConditionMode::Less },
+            { "lessequal", ScConditionMode::EqLess },
+            { "greater", ScConditionMode::Greater },
+            { "greaterequal", ScConditionMode::EqGreater },
+            { "between", ScConditionMode::Between },
+            { "notbetween", ScConditionMode::NotBetween } };
+    static const std::pair<std::string_view, ScValidErrorStyle> aStyles[]
+        = { { "stop", SC_VALERR_STOP },
+            { "warning", SC_VALERR_WARNING },
+            { "info", SC_VALERR_INFO } };
+    auto find = [](const auto& rTable, const std::string& rKey) {
+        return std::find_if(std::begin(rTable), std::end(rTable),
+                            [&rKey](const auto& rPair) { return rPair.first == rKey; });
+    };
+    const auto pMode = find(aModes, rRule.get<std::string>("type", "any"));
+    const auto pOperator = find(aOperators, rRule.get<std::string>("operator", "equal"));
+    const auto pStyle = find(aStyles, rRule.get<std::string>("errorStyle", "stop"));
+    if (pMode == std::end(aModes) || pOperator == std::end(aOperators)
+        || pStyle == std::end(aStyles))
+        return false;
+    ScDocument& rDoc = rData.GetDocument();
+    OUString aExpr1 = lcl_Text(rRule, "value1");
+    OUString aExpr2 = lcl_Text(rRule, "value2");
+    if (pMode->second == SC_VALID_DATE || pMode->second == SC_VALID_TIME)
+    {
+        aExpr1 = lcl_Moment(rDoc, aExpr1);
+        aExpr2 = lcl_Moment(rDoc, aExpr2);
+    }
+    if (const auto oList = rRule.get_child_optional("list"); oList && !oList->empty())
+    {
+        // Entries as the dialog writes them: quoted, separated.
+        OUStringBuffer aList;
+        for (const auto& rEntry : *oList)
+        {
+            if (!aList.isEmpty())
+                aList.append(ScCompiler::GetNativeSymbol(ocSep));
+            aList.append("\"" + OUString::fromUtf8(rEntry.second.data()).replaceAll("\"", "\"\"")
+                         + "\"");
+        }
+        aExpr1 = aList.makeStringAndClear();
+    }
+    const ScAddress aPos(rData.GetCurX(), rData.GetCurY(), rData.CurrentTabForData());
+    ScValidationData aData(pMode->second, pOperator->second, aExpr1, aExpr2, rDoc, aPos);
+    aData.SetIgnoreBlank(rRule.get<bool>("ignoreBlank", true));
+    aData.SetListType(rRule.get<bool>("dropdown", true)
+                          ? css::sheet::TableValidationVisibility::UNSORTED
+                          : css::sheet::TableValidationVisibility::INVISIBLE);
+    aData.SetInput(lcl_Text(rRule, "inputTitle"), lcl_Text(rRule, "inputMessage"));
+    if (!rRule.get<bool>("showInput", false))
+        aData.ResetInput();
+    aData.SetError(lcl_Text(rRule, "errorTitle"), lcl_Text(rRule, "errorMessage"),
+                   pStyle->second);
+    if (!rRule.get<bool>("showError", false))
+        aData.ResetError();
+    rView.SetValidation(aData);
+    return true;
+}
+
+/// One query item from a value typed as text.
+void lcl_SetItem(ScDocument& rDoc, ScQueryEntry::Item& rItem, const OUString& rText)
+{
+    sal_uInt32 nIndex = 0;
+    double fValue;
+    rItem.maString = rDoc.GetSharedStringPool().intern(rText);
+    rItem.meType = rDoc.GetFormatTable()->IsNumberFormat(rText, nIndex, fValue)
+                       ? ScQueryEntry::ByValue
+                       : ScQueryEntry::ByString;
+    rItem.mfVal = rItem.meType == ScQueryEntry::ByValue ? fValue : 0.0;
+}
