+/// The JSON argument `nWhich` of `rReq`, read into `rTree`.
+bool lcl_JsonArg(const SfxRequest& rReq, sal_uInt16 nWhich, boost::property_tree::ptree& rTree)
+{
+    const SfxItemSet* pArgs = rReq.GetArgs();
+    const SfxPoolItem* pItem = nullptr;
+    if (!pArgs || pArgs->GetItemState(nWhich, true, &pItem) != SfxItemState::SET)
+        return false;
+    std::stringstream aStream(
+        std::string(static_cast<const SfxStringItem*>(pItem)->GetValue().toUtf8()));
+    try
+    {
+        boost::property_tree::read_json(aStream, rTree);
+    }
+    catch (const boost::property_tree::json_parser_error&)
+    {
+        return false;
+    }
+    return true;
+}
+
+OUString lcl_Text(const boost::property_tree::ptree& rTree, const char* pKey)
+{
+    return OUString::fromUtf8(rTree.get<std::string>(pKey, ""));
+}
+
+/// A typed date or time, as the dialog stores it.
+OUString lcl_Moment(ScDocument& rDoc, const OUString& rText)
+{
+    sal_uInt32 nIndex = 0;
+    double fValue;
+    if (!rDoc.GetFormatTable()->IsNumberFormat(rText, nIndex, fValue))
+        return rText;
+    return rtl::math::doubleToUString(fValue, rtl_math_StringFormat_Automatic,
+                                      rtl_math_DecimalPlaces_Max,
+                                      ScGlobal::getLocaleData().getNumDecimalSep()[0], true);
+}
