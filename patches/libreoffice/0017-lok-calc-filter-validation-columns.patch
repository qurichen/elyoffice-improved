+/// Filters the cursor's data by a kit client's conditions.
+bool lcl_Query(ScTabViewShell& rView, ScViewData& rData, const boost::property_tree::ptree& rQuery)
+{
+    ScDBData* pDBData = rView.GetDBData();
+    if (!pDBData)
+        return false;
+    ScDocument& rDoc = rData.GetDocument();
+    ScQueryParam aParam;
+    pDBData->GetQueryParam(aParam);
+    // With a column, only that column's conditions change.
+    const auto oColumn = rQuery.get_optional<SCCOLROW>("column");
+    if (oColumn)
+        aParam.RemoveAllEntriesByField(*oColumn);
+    else
+        for (SCSIZE i = 0; i < aParam.GetEntryCount(); ++i)
+            aParam.GetEntry(i).Clear();
+    aParam.bHasHeader = pDBData->HasHeader();
+    aParam.bInplace = true;
+    aParam.bDuplicate = true;
+    aParam.bCaseSens = false;
+    aParam.eSearchType = utl::SearchParam::SearchType::Normal;
+    const auto oConditions = rQuery.get_child_optional("conditions");
+    if (oConditions)
+    {
+        for (const auto& rPair : *oConditions)
+        {
+            const boost::property_tree::ptree& rCondition = rPair.second;
+            const SCCOLROW nField = oColumn ? *oColumn : rCondition.get<SCCOLROW>("field", -1);
+            if (nField < aParam.nCol1 || nField > aParam.nCol2)
+                return false;
+            ScQueryEntry* pEntry = nullptr;
+            for (SCSIZE i = 0; i < aParam.GetEntryCount() && !pEntry; ++i)
+                if (!aParam.GetEntry(i).bDoQuery)
+                    pEntry = &aParam.GetEntry(i);
+            if (!pEntry)
+                pEntry = &aParam.AppendEntry();
+            pEntry->bDoQuery = true;
+            pEntry->nField = nField;
+            pEntry->eConnect = rCondition.get<bool>("or", false) ? SC_OR : SC_AND;
+            const std::string aOp = rCondition.get<std::string>("op", "");
+            const OUString aValue = lcl_Text(rCondition, "value");
+            if (aOp == "empty")
+                pEntry->SetQueryByEmpty();
+            else if (aOp == "notempty")
+                pEntry->SetQueryByNonEmpty();
+            else if (aOp == "values")
+            {
+                // The column's own entries, so types match.
+                std::set<OUString> aWanted;
+                if (const auto oValues = rCondition.get_child_optional("values"))
+                    for (const auto& rValue : *oValues)
+                        aWanted.insert(OUString::fromUtf8(rValue.second.data()));
+                ScFilterEntries aEntries;
+                rDoc.GetFilterEntries(nField, aParam.nRow1, rData.CurrentTabForData(), aEntries);
+                pEntry->eOp = SC_EQUAL;
+                ScQueryEntry::QueryItemsType& rItems = pEntry->GetQueryItems();
+                rItems.clear();
+                for (const ScTypedStrData& rStr : aEntries)
+                {
+                    if (!aWanted.count(rStr.GetString()))
+                        continue;
+                    ScQueryEntry::Item aItem;
+                    aItem.maString = rDoc.GetSharedStringPool().intern(rStr.GetString());
+                    aItem.meType = rStr.IsDate() ? ScQueryEntry::ByDate
+                                   : rStr.GetStringType() == ScTypedStrData::Value
+                                       ? ScQueryEntry::ByValue
+                                       : ScQueryEntry::ByString;
+                    aItem.mfVal = rStr.GetValue();
+                    rItems.push_back(aItem);
+                }
+                if (aWanted.count(OUString()))
+                {
+                    ScQueryEntry::Item aEmpty;
+                    aEmpty.maString = rDoc.GetSharedStringPool().intern(OUString());
+                    rItems.push_back(aEmpty);
+                }
+            }
+            else
+            {
+                static const std::pair<std::string_view, ScQueryOp> aOps[]
+                    = { { "contains", SC_CONTAINS }, { "equals", SC_EQUAL },
+                        { "notequals", SC_NOT_EQUAL }, { "greater", SC_GREATER },
+                        { "less", SC_LESS }, { "greaterequal", SC_GREATER_EQUAL },
+                        { "lessequal", SC_LESS_EQUAL } };
+                const auto pOp = std::find_if(std::begin(aOps), std::end(aOps),
+                                              [&aOp](const auto& rPair) { return rPair.first == aOp; });
+                if (pOp == std::end(aOps))
+                    return false;
+                pEntry->eOp = pOp->second;
+                lcl_SetItem(rDoc, pEntry->GetQueryItem(), aValue);
+            }
+        }
+    }
+    rView.Query(aParam, nullptr, true);
+    return true;
+}
