+
+/// Whether rCode lost a reference or holds an error.
+bool lcl_IsBroken(const ScTokenArray& rCode)
+{
+    formula::FormulaTokenArrayPlainIterator aIter(rCode);
+    for (const formula::FormulaToken* pToken = aIter.First(); pToken; pToken = aIter.Next())
+    {
+        if (pToken->GetType() == formula::svError || pToken->GetOpCode() == ocBad)
+            return true;
+        if (pToken->GetType() == formula::svSingleRef && pToken->GetSingleRef()->IsDeleted())
             return true;
+        if (pToken->GetType() == formula::svDoubleRef
+            && (pToken->GetDoubleRef()->Ref1.IsDeleted() || pToken->GetDoubleRef()->Ref2.IsDeleted()))
+            return true;
+    }
     return false;
+}
+
+/// Every named range: name, scope, formula, and whether it broke.
+void lcl_DefinedNames(tools::JsonWriter& rJsonWriter, ScDocument& rDoc)
+{
+    rJsonWriter.put("commandName", ".uno:DefinedNames");
+    auto aNames = rJsonWriter.startArray("names");
+    auto aPut = [&rJsonWriter, &rDoc](const ScRangeName* pNames, const OUString& rScope) {
+        if (!pNames)
+            return;
+        for (const auto& [rKey, pData] : *pNames)
+        {
+            auto aName = rJsonWriter.startStruct();
+            rJsonWriter.put("name", pData->GetName());
+            rJsonWriter.put("scope", rScope);
+            rJsonWriter.put("formula", pData->GetSymbol(rDoc.GetGrammar()));
+            // The absolute range it names, if it is one.
+            ScRange aRange;
+            OUString aTarget;
+            const ScAddress::Details aDetails(rDoc.GetAddressConvention(), 0, 0);
+            if (pData->IsValidReference(aRange))
+                aTarget = aRange.aStart == aRange.aEnd
+                              ? aRange.aStart.Format(ScRefFlags::ADDR_ABS_3D, &rDoc, aDetails)
+                              : aRange.Format(rDoc, ScRefFlags::RANGE_ABS_3D, aDetails);
+            rJsonWriter.put("range", aTarget);
+            rJsonWriter.put("broken", pData->GetErrCode() != FormulaError::NONE
+                                          || (pData->GetCode() && lcl_IsBroken(*pData->GetCode())));
+        }
+    };
+    aPut(rDoc.GetRangeName(), OUString());
+    for (SCTAB nTab = 0; nTab < rDoc.GetTableCount(); ++nTab)
+    {
+        OUString aSheet;
+        rDoc.GetName(nTab, aSheet);
+        aPut(rDoc.GetRangeName(nTab), aSheet);
+    }
 }
 }
 
