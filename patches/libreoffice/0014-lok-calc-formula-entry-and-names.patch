 namespace{
+/// Sets a name; an empty rSymbol removes it.
+bool lcl_DefineName(ScDocShell& rDocSh, const ScAddress& rPos, const OUString& rName,
+                    const OUString& rSymbol, const OUString& rScope)
+{
+    ScDocument& rDoc = rDocSh.GetDocument();
+    SCTAB nScope = -1;
+    if (!rScope.isEmpty() && !rDoc.GetTable(rScope, nScope))
+        return false;
+    std::map<OUString, ScRangeName*> aOld;
+    rDoc.GetRangeNameMap(aOld);
+    std::map<OUString, ScRangeName> aNew;
+    for (const auto& [rKey, pNames] : aOld)
+        aNew.emplace(rKey, *pNames);
+    ScRangeName& rList = aNew[rScope.isEmpty() ? STR_GLOBAL_RANGE_NAME : rScope];
+    const ScRangeData* pOld = rList.findByUpperName(ScGlobal::getCharClass().uppercase(rName));
+    const sal_uInt16 nIndex = pOld ? pOld->GetIndex() : 0;
+    if (pOld)
+        rList.erase(*pOld);
+    else if (rSymbol.isEmpty())
+        return false;
+    if (!rSymbol.isEmpty())
+    {
+        if (ScRangeData::IsNameValid(rName, rDoc) != ScRangeData::IsNameValidType::NAME_VALID)
+            return false;
+        std::unique_ptr<ScRangeData> pNew(new ScRangeData(
+            rDoc, rName, rSymbol, rPos, ScRangeData::Type::Name, rDoc.GetGrammar()));
+        if (pNew->GetErrCode() != FormulaError::NONE)
+            return false;
+        pNew->SetIndex(nIndex);
+        if (!rList.insert(pNew.release(), false))
+            return false;
+    }
+    rDocSh.GetDocFunc().ModifyAllRangeNames(aNew);
+    return true;
+}
