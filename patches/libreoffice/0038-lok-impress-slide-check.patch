+/// Fonts a text object asks for, all scripts.
+void lcl_TextFonts(const SdrTextObj& rObj, std::set<OUString>& rFonts)
+{
+    for (const auto& nWhich : { EE_CHAR_FONTINFO, EE_CHAR_FONTINFO_CJK, EE_CHAR_FONTINFO_CTL })
+        rFonts.insert(rObj.GetMergedItem(nWhich).GetFamilyName());
+    for (sal_Int32 nText = 0; nText < rObj.getTextCount(); ++nText)
+    {
+        const OutlinerParaObject* pText = rObj.getText(nText)->GetOutlinerParaObject();
+        if (!pText)
+            continue;
+        const EditTextObject& rEdit = pText->GetTextObject();
+        for (sal_Int32 nPara = 0; nPara < rEdit.GetParagraphCount(); ++nPara)
+        {
+            std::vector<EECharAttrib> aAttribs;
+            rEdit.GetCharAttribs(nPara, aAttribs);
+            for (const EECharAttrib& rAttrib : aAttribs)
+                if (auto pFont = dynamic_cast<const SvxFontItem*>(rAttrib.pAttr))
+                    rFonts.insert(pFont->GetFamilyName());
+        }
+    }
+}
+
+/// Fonts asked for, linked files, objects the kernel cannot show.
+void lcl_PageCheck(::tools::JsonWriter& rJson, SdPage& rPage)
+{
+    std::set<OUString> aFonts;
+    std::vector<std::pair<OUString, bool>> aLinks;
+    std::vector<OUString> aBroken;
+    SdrObjListIter aIter(&rPage, SdrIterMode::DeepNoGroups);
+    while (aIter.IsMore())
+    {
+        SdrObject* pObj = aIter.Next();
+        if (pObj->isAnnotationObject() || pObj->IsEmptyPresObj())
+            continue;
+        if (auto pText = DynCastSdrTextObj(pObj); pText && pText->HasText())
+            lcl_TextFonts(*pText, aFonts);
+        if (auto pGraf = dynamic_cast<SdrGrafObj*>(pObj))
+        {
+            bool bThere = true;
+            if (pGraf->IsLinkedGraphic())
+            {
+                osl::DirectoryItem aItem;
+                bThere = osl::DirectoryItem::get(pGraf->GetFileName(), aItem) == osl::FileBase::E_None;
+                aLinks.emplace_back(pGraf->GetFileName(), !bThere);
+            }
+            // Loads a link; a failed decode leaves the placeholder.
+            const GraphicType eType = pGraf->GetGraphicObject(true).GetType();
+            // A missing link is said once, as a link.
+            if (bThere && (eType == GraphicType::NONE || eType == GraphicType::Default))
+                aBroken.push_back(pObj->GetName());
+        }
+        if (auto pOle = dynamic_cast<SdrOle2Obj*>(pObj))
+        {
+            uno::Reference<embed::XLinkageSupport> xLink(pOle->getEmbeddedObjectRef().GetObject(), uno::UNO_QUERY);
+            if (xLink.is() && xLink->isLink())
+            {
+                osl::DirectoryItem aItem;
+                const OUString aUrl = xLink->getLinkURL();
+                aLinks.emplace_back(aUrl, osl::DirectoryItem::get(aUrl, aItem) != osl::FileBase::E_None);
+            }
+            if (pOle->IsEmpty())
+                aBroken.push_back(pObj->GetName());
+        }
+    }
+    {
+        auto aList = rJson.startArray("fonts");
+        for (const OUString& rFont : aFonts)
+            if (!rFont.isEmpty())
+                rJson.putSimpleValue(rFont);
+    }
+    {
+        auto aList = rJson.startArray("links");
+        for (const auto& [rUrl, bMissing] : aLinks)
+        {
+            auto aOne = rJson.startStruct();
+            rJson.put("url", rUrl);
+            rJson.put("missing", bMissing);
+        }
+    }
+    auto aList = rJson.startArray("broken");
+    for (const OUString& rName : aBroken)
+        rJson.putSimpleValue(rName);
+}
+
+/// Every slide and master, checked before a show.
+void lcl_SlideCheck(::tools::JsonWriter& rJson, SdDrawDocument& rDoc)
+{
+    {
+        auto aList = rJson.startArray("slides");
+        for (sal_uInt16 i = 0; i < rDoc.GetSdPageCount(PageKind::Standard); ++i)
+        {
+            auto aOne = rJson.startStruct();
+            lcl_PageCheck(rJson, *rDoc.GetSdPage(i, PageKind::Standard));
+        }
+    }
+    auto aList = rJson.startArray("masters");
+    for (sal_uInt16 i = 0; i < rDoc.GetMasterSdPageCount(PageKind::Standard); ++i)
+    {
+        SdPage* pMaster = rDoc.GetMasterSdPage(i, PageKind::Standard);
+        auto aOne = rJson.startStruct();
+        rJson.put("name", pMaster->GetName());
+        lcl_PageCheck(rJson, *pMaster);
+    }
+}
