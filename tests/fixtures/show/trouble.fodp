<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
 xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
 xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
 xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0"
 xmlns:xlink="http://www.w3.org/1999/xlink"
 xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0"
 xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0"
 office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.presentation">
 <office:font-face-decls><style:font-face style:name="Nowhere Sans" svg:font-family="'Nowhere Sans'"/></office:font-face-decls>
 <office:automatic-styles>
  <style:style style:name="T1" style:family="text"><style:text-properties style:font-name="Nowhere Sans"/></style:style>
 </office:automatic-styles>
 <office:body><office:presentation>
 <draw:page draw:name="One"><draw:frame svg:x="2cm" svg:y="2cm" svg:width="10cm" svg:height="3cm"><draw:text-box><text:p><text:span text:style-name="T1">Lost font</text:span></text:p></draw:text-box></draw:frame></draw:page>
 <draw:page draw:name="Two"><draw:frame draw:name="Gone" svg:x="2cm" svg:y="2cm" svg:width="6cm" svg:height="4cm"><draw:image xlink:href="file:///nowhere/gone.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad"/></draw:frame></draw:page>
 <draw:page draw:name="Three"><draw:frame draw:name="Empty" svg:x="2cm" svg:y="2cm" svg:width="6cm" svg:height="4cm"><draw:object xlink:href="./Object 9" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad"/></draw:frame></draw:page>
 <draw:page draw:name="Four"><draw:frame draw:name="Bad" svg:x="2cm" svg:y="2cm" svg:width="6cm" svg:height="4cm"><draw:image xlink:href="broken.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad"/></draw:frame><draw:frame draw:name="Junk" svg:x="9cm" svg:y="2cm" svg:width="6cm" svg:height="4cm"><draw:image><office:binary-data>bm90IGFuIGltYWdlIGF0IGFsbA==</office:binary-data></draw:image></draw:frame></draw:page>
 <draw:page draw:name="Five"><draw:frame draw:name="Linked" svg:x="2cm" svg:y="2cm" svg:width="6cm" svg:height="4cm"><draw:object xlink:href="linked.odt" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad"/></draw:frame></draw:page>
 </office:presentation></office:body>
</office:document>
